# Template for .env.production.local — used ONLY by prisma.production.config.ts
# to apply migrations to the production database.
#
#   cp .env.production.local.example .env.production.local
#
# .env.production.local is gitignored (via `.env*` in .gitignore). This example
# file is not, and must never contain a real credential.
#
# ── Where to get the value ───────────────────────────────────────────────────
# Railway -> trading-alerts -> Postgres -> Variables -> DATABASE_PUBLIC_URL
#
# Use the PUBLIC url. `postgres.railway.internal` is Railway's private-network
# address: it works for services running inside Railway (which is why
# railway-gateway uses it) and never resolves from a laptop.
#
# As of 2026-09-09 the production Postgres public TCP proxy is
# maglev.proxy.rlwy.net:58290. Confirm in the dashboard rather than trusting
# this comment — Railway proxy hostnames and ports can change, and note that
# these hostnames are SHARED across many services, so the port is what actually
# identifies the service.
#
# ── Why both variables ───────────────────────────────────────────────────────
# Prisma migrations read DIRECT_URL (see prisma.config.ts). DATABASE_URL is set
# too so the file is usable for ad-hoc read-only checks. Point both at the same
# production value.
#
# ── When you're done ─────────────────────────────────────────────────────────
# Delete .env.production.local. It holds a live database credential.

DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

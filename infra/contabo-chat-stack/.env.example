# Copy to /opt/saas-chat/.env on the Contabo VPS. Never commit a filled-in copy
# of this file — values only ever live on the VPS or in Davin's secret manager
# (LESSONS-LEARNED.md L4/L17).

# --- socket_chat_server ---
PORT=3001
NODE_ENV=production
REDIS_URL=redis://redis_broker:6379
# 256-bit secret, generate with: openssl rand -hex 32
CHAT_JWT_SECRET=
# Comma-separated list of allowed browser origins
CORS_ORIGIN=https://davintrade.app,https://trading-alerts-saas-public.vercel.app
GUEST_RATE_LIMIT_PER_HOUR=10

# --- ai_bot_worker ---
# gemini | claude
LLM_PROVIDER=gemini
# gemini-3.5-flash verified live and working on Contabo at Session 14-1's
# close (2026-08-30) — a real end-to-end smoke test got a genuine reply from
# it. The originally-placeholdered gemini-1.5-flash/claude-3-5-haiku-20241022
# IDs (14-0 Deviation 6) were never actually re-tried, so it's unconfirmed
# whether they'd also still work — this is just the one that's live now.
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
AUTH_MONTHLY_QUOTA=500

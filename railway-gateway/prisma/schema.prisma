// This schema exists ONLY so this service can `prisma generate` a typed
// client for the one table it writes to. It is NOT the source of truth for
// migrations — the root Next.js app (`prisma/market-data/schema.prisma`)
// owns the actual `market_data_v6` table and its migration history (shared
// with prisma/non-market-data/schema.prisma — see LESSONS-LEARNED.md L24).
// NEVER run `prisma migrate` from this package: two independent Prisma
// projects managing migrations against the same physical table would fight
// over the `_prisma_migrations` bookkeeping table.
//
// Keep this model definition byte-for-byte in sync with the `MarketDataV6`
// model in the root schema (`../../prisma/market-data/schema.prisma`) — the
// dto-contract test in this package's test suite does not check this file,
// so any change to the field list must be applied in both places by hand.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model MarketDataV6 {
  id          String @id @default(cuid())
  terminal_id String
  timestamp   Int
  symbol      String
  timeframe   String
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Int

  // Centroid-regression variant: best_fit_a (config-identical to the former
  // single best_fit; 2026-09-03 isolated-coexistence split, see blueprint §3.4)
  best_fit_a_horiz_high_map Float?
  best_fit_a_horiz_low_map  Float?
  best_fit_a_ssa            Float?
  best_fit_a_ema_ssa        Float?
  best_fit_a_crossing       Int?
  best_fit_a_base_fl        Float?
  best_fit_a_uoedt          Float?
  best_fit_a_loedt          Float?

  // Centroid-regression variant: best_fit_b (new preset, no historical data
  // before 2026-09-03 — never certified, see CERTIFICATION.md)
  best_fit_b_horiz_high_map Float?
  best_fit_b_horiz_low_map  Float?
  best_fit_b_ssa            Float?
  best_fit_b_ema_ssa        Float?
  best_fit_b_crossing       Int?
  best_fit_b_base_fl        Float?
  best_fit_b_uoedt          Float?
  best_fit_b_loedt          Float?

  // Centroid-regression variant: cherry_a
  cherry_a_horiz_high_map Float?
  cherry_a_horiz_low_map  Float?
  cherry_a_ssa            Float?
  cherry_a_ema_ssa        Float?
  cherry_a_crossing       Int?
  cherry_a_base_fl        Float?
  cherry_a_uoedt          Float?
  cherry_a_loedt          Float?

  // Centroid-regression variant: cherry_b
  cherry_b_horiz_high_map Float?
  cherry_b_horiz_low_map  Float?
  cherry_b_ssa            Float?
  cherry_b_ema_ssa        Float?
  cherry_b_crossing       Int?
  cherry_b_base_fl        Float?
  cherry_b_uoedt          Float?
  cherry_b_loedt          Float?

  // Centroid-regression variant: most_recent
  most_recent_horiz_high_map Float?
  most_recent_horiz_low_map  Float?
  most_recent_ssa            Float?
  most_recent_ema_ssa        Float?
  most_recent_crossing       Int?
  most_recent_base_fl        Float?
  most_recent_uoedt          Float?
  most_recent_loedt          Float?

  // Centroid-regression variant: non_a
  non_a_horiz_high_map Float?
  non_a_horiz_low_map  Float?
  non_a_ssa            Float?
  non_a_ema_ssa        Float?
  non_a_crossing       Int?
  non_a_base_fl        Float?
  non_a_uoedt          Float?
  non_a_loedt          Float?

  // Centroid-regression variant: non_b
  non_b_horiz_high_map Float?
  non_b_horiz_low_map  Float?
  non_b_ssa            Float?
  non_b_ema_ssa        Float?
  non_b_crossing       Int?
  non_b_base_fl        Float?
  non_b_uoedt          Float?
  non_b_loedt          Float?

  // Fractal EDT + single best lines (calculated)
  fractal_best_fl Float?
  fractal_uoedt   Float?
  fractal_loedt   Float?
  best_resistance Float?
  best_support    Float?

  // Z-Score candle (calculated)
  body_direction      Int? // -1, 0, 1
  body_size           Float? // |z-score| (export convention)
  body_classification Int? // 0-5

  // ZigZag (pivot = admin layer; metrics + category calculated)
  zigzag_point_type          String? // "Peak" | "Bottom"
  zigzag_current_point       Float?
  zigzag_price_change        Float?
  zigzag_pct_change          Float?
  zigzag_pct_change_class    Int?
  zigzag_bars                Int?
  zigzag_bars_class          Int?
  zigzag_price_per_bar       Float?
  zigzag_price_per_bar_class Int?
  zigzag_slope               Float?
  zigzag_category            String? // HH | HL | LH | LL | EQH | EQL

  // Provenance
  cycle_id      Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  collected_at  Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  calculated_at Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_data_v6")
}

/// APPEND-ONLY. One row per (source, timeframe, collection cycle) — a snapshot of
/// what an indicator's fit looked like at that moment, parsed from the
/// _Statistic.txt companion the MQL5 indicators already write.
///
/// This is the deliberate opposite of MarketDataV6. That table is keyed by WHICH
/// BAR, so re-pushing a bar overwrites it — correct for live charting, but it
/// means a historical row holds the latest refit rather than what the indicator
/// actually said at the time. This table is keyed by WHEN IT WAS OBSERVED
/// (captured_at), so a new row never collides with an old one and history is
/// never rewritten. That is what makes it usable for drift detection and
/// walk-forward scoring.
///
/// The ONLY permitted write to an existing row is an idempotent re-push of
/// byte-identical content (push retries are by design). A correction is a NEW
/// row with a later captured_at — never an update.
///
/// Nothing here is derivable from market_data_v6: R2, MSE, variance ratio,
/// skewness, kurtosis, containment and window size exist nowhere else in the
/// pipeline. See STATISTIC-CAPTURE-SCOPE.md in the v2_29 pipeline folder.
model IndicatorStatistic {
  id String @id @default(cuid())

  // Identity + when observed
  terminal_id String
  symbol      String
  timeframe   String
  source      String // best_fit_a | best_fit_b | cherry_a | cherry_b | most_recent | non_a | non_b | fractal_edt | resistance | support
  captured_at Int // unix — the collector's 5-minute cycle slot; the append-only half of the key
  live_bar_ts Int // newest bar in that export; joins to MarketDataV6.timestamp
  cycle_id    Int

  // Resolved line. solution_found/line_origin_ts/touches come from the 3 line
  // indicators only; the centroids leave them null.
  solution_found   Boolean?
  raw_slope        Float?
  anchored_y_int   Float?
  regression_angle Float?
  line_origin_ts   Int?
  touches          Int?

  // Fitting window
  window_start_ts Int?
  window_end_ts   Int?
  window_bars     Int? // centroids: Observation Window (Box B Bars)
  math_lookback   Int? // centroids: Math Search Window (Bars)
  crossings_n     Int? // centroids: Total Crossings (n)

  // [MODEL A; CROSSINGS] — centroids only (the line indicators have no crossings)
  model_a_n         Int?
  model_a_r2        Float?
  model_a_mse       Float?
  model_a_var_ratio Float?
  model_a_skew      Float?
  model_a_kurt      Float?

  // [MODEL B; CLOSE PRICE] — all 10 sources. These lines are fitted to centroids
  // or fractal touches, NOT to closes, so a low or negative r2 is structurally
  // expected here and is not by itself a fault.
  model_b_n         Int?
  model_b_r2        Float?
  model_b_mse       Float?
  model_b_var_ratio Float?
  model_b_skew      Float?
  model_b_kurt      Float?

  // [EDT CHANNEL] — the 7 centroids + fractal_edt. resistance/support are single
  // lines with no channel, so they leave these null.
  uoedt_offset      Float?
  loedt_offset      Float?
  containment_n     Int?
  containment_count Int?
  containment_rate  Float? // percent of the fitted window that closed inside the channel

  // Which configuration produced this fit. Deduplicated because the parameters
  // are compiled into the .mq5 and change only on redeploy — storing them inline
  // would repeat an identical blob on every row. A NEW hash appearing is itself
  // the drift signal (the indicator was reconfigured).
  config_hash String
  config      IndicatorConfig @relation(fields: [config_hash], references: [config_hash])

  createdAt DateTime @default(now())

  // The append-only key. Postgres backs this with a btree index on exactly
  // these columns, so it also serves "this indicator, this timeframe, over
  // time" reads — no separate @@index on the same list.
  @@unique([symbol, timeframe, source, captured_at])
  @@index([source, captured_at])
  @@map("indicator_statistics")
}

/// The indicator input parameters behind an IndicatorStatistic, stored once per
/// distinct configuration rather than once per row.
///
/// The gateway processor MUST upsert this row BEFORE the statistic that
/// references it — IndicatorStatistic.config_hash is a real foreign key.
model IndicatorConfig {
  config_hash String @id // sha256 of the normalised parameter block
  source      String
  params      Json // the parameter block verbatim, as parsed key/value pairs
  first_seen  Int // unix — when this configuration was first observed

  createdAt  DateTime             @default(now())
  statistics IndicatorStatistic[]

  @@index([source])
  @@map("indicator_configs")
}

/// One observation of one economic-calendar release, read from MT5's built-in
/// Economic Calendar on the same terminal that runs the 13 export indicators.
///
/// APPEND-ONLY, enforced by the KEY rather than a trigger: a revised forecast
/// or a newly published actual is a NEW row with a later captured_at, never an
/// update. Overwriting would destroy what the market knew BEFORE the release —
/// the same loss HISTORICAL-VALUES-LOOK-AHEAD-BIAS-OPEN-ISSUE.md records as
/// unrecoverable for market_data. Current state is
/// `DISTINCT ON (value_id) ... ORDER BY value_id, captured_at DESC`; the
/// reverse, recovering history from an overwritten row, is impossible.
///
/// NOT symbol-scoped. Economic events are global; relevance to XAUUSD is
/// derived from `currency` at query time rather than denormalised here.
model EconomicEvent {
  id String @id @default(cuid())

  terminal_id String

  // Ids are String, not Int or BigInt. Upstream they are MQL5 `ulong` (64-bit)
  // and JSON has no 64-bit integer, so a large id would silently lose precision
  // crossing the gateway. They are opaque — never used for arithmetic, and
  // ordering is always by captured_at / event_time.
  value_id    String // MqlCalendarValue.id — one specific release
  captured_at Int // unix UTC — when observed; the append-only half of the key
  event_id    String // MqlCalendarEvent.id — the recurring event

  event_time   Int // unix UTC — when the event occurs (converted from server time at source)
  event_period Int? // unix UTC — the reporting period covered, not the publication moment
  revision     Int?

  country_code String // ISO 3166-1 alpha-2
  currency     String // ISO 4217 — the XAUUSD relevance filter

  event_name String
  importance String // NONE | LOW | MODERATE | HIGH

  // Raw upstream enums, stored unmapped. time_mode matters to consumers: a
  // non-exact mode means event_time is a day or a floating estimate, so a
  // countdown must not imply second precision for those.
  event_type Int?
  sector     Int?
  frequency  Int?
  time_mode  Int?
  unit       Int?
  multiplier Int?
  digits     Int?
  event_code String?
  source_url String?

  // Values, already divided by 10^6 at source.
  //
  // NULL means NOT PUBLISHED, never zero — a genuine 0.0 reading is real data.
  // For forecast_value NULL is the COMMON case: Step Zero measured only 12 of
  // 23 upcoming HIGH-impact events carrying one, because rate decisions, votes
  // and speeches structurally have no numeric forecast. Consumers must render
  // "no forecast published" rather than substitute a number.
  actual_value       Float?
  forecast_value     Float?
  prev_value         Float?
  revised_prev_value Float?
  impact_type        Int? // ENUM_CALENDAR_EVENT_IMPACT — upstream's opinion, not ours

  createdAt DateTime @default(now())

  // The append-only key. Postgres backs a unique constraint with a btree index
  // on exactly these columns, so no separate @@index repeats this list.
  @@unique([value_id, captured_at])
  // "What is the next HIGH-impact event?" — the countdown's only query.
  @@index([event_time, importance])
  // "What is coming for USD?" — the Stack D news pillar's filter.
  @@index([currency, event_time])
  @@map("economic_events")
}

/// Lane 4: G8 Currency & Gold Index Suite — the public landing-page widget's
/// data source (8 equal-weighted currency indices + rebased gold index XAUX).
///
/// One row per (index_name, bar_time) — NOT a revision stream like
/// IndicatorStatistic/EconomicEvent above. Each bar's value is a
/// deterministic, stateless recomputation from that bar's own rates (see
/// currency_gold_index_engine.py's index_value() docstring), so a given key
/// has exactly one correct value and the gateway upserts in place; a retry
/// delivering the same key is a true no-op, not an append.
///
/// Written by currency_gold_index_engine.py, a FULLY SEPARATE process from
/// the v6 alert pipeline — own script, own NSSM service, own SQLite outbox
/// (never xauusd.db), own input files. A failure in this lane can never
/// affect market_data_v6, IndicatorStatistic or EconomicEvent in any way.
model CurrencyGoldIndex {
  id String @id @default(cuid())

  terminal_id String
  index_name  String // XAUX | USDX | EURX | JPYX | GBPX | AUDX | NZDX | CADX | CHFX
  bar_time    Int // unix UTC — the M5 bar this value was computed for

  value      Float // rebased to exactly 100.00 at session_open_bar_time by construction
  change_pct Float // == value - 100.00 always (closed-form; stored for API convenience)

  // unix UTC — today's session-inception bar for THIS index (00:00 Eightcap
  // server time for the 8 currency indices, 01:01 for XAUX's own daily
  // rollover reopen). Stamped by the engine, which alone has ground truth of
  // the documented Eightcap UTC-offset rule, so no downstream reader ever has
  // to re-derive today's session boundary via its own DST-offset logic.
  session_open_bar_time Int

  createdAt DateTime @default(now())

  // One row per (index_name, bar_time). Postgres backs this with a btree
  // index Postgres also uses for the "this index over time" sparkline read —
  // no separate non-unique index on the same list.
  @@unique([index_name, bar_time])
  @@index([index_name, bar_time(sort: Desc)])
  @@map("currency_gold_indices")
}

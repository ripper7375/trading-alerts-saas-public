# Secrets and local state: a manual `railway up` uploads the working directory,
# so a developer's .env must never travel with it. Keep the example file.
.env
.env.*
!.env.example

# Logs, test output and test sources are not needed to build or run the service.
# (`scripts/` and `sensors/` stay: the build compiles scripts/**/*.ts and the sensor
# worker runs the Python kit from sensors/.)
coverage/
*.log
.git/
src/**/*.spec.ts
test/

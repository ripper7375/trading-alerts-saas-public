# Server
NODE_ENV=development
PORT=3000

# Redis (Bull queue + rate limiting)
REDIS_URL=redis://localhost:6379

# Downstream store — the SAME Postgres database as the root Next.js app
# (its migration owns the market_data_v6 table; this service only runs
# `prisma generate`, never `prisma migrate`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_alerts

# Auth — one key per sender (Push Worker, optionally Relay)
API_KEYS=push_worker_v5_CHANGE_ME,mt5_relay_v2_29_CHANGE_ME

# Rate limiting
RATE_LIMIT_MAX=100

# CORS — not relevant today (callers are server-side only), placeholder
ALLOWED_ORIGINS=

# Sensor worker (build step 3 part 4): the consumer of the cycle-ready queue, which reads a cycle's
# inputs, runs the Python MCD runner and writes mcd_outputs. OFF unless the value is exactly `true`;
# off, it registers nothing (the jobs wait in Redis). Turning it on is phase B0: the migration applied,
# Python 3.11 with PyYAML and jsonschema and the engine folder in the image. See src/sensors/sensor-config.ts.
SENSOR_WORKER_ENABLED=false
# SENSOR_RETUNING_ENFORCED=false     (exactly `true` tells the sensors about a promote; default false)
# SENSOR_PYTHON=python
# SENSOR_ENGINE_DIR=                 (folder with mcd_common, mcd0.. and mcd_worker; default: this checkout's)
# SENSOR_WORKER_CONFIG=              (a worker_config.yaml override; default: the committed one, every MCD off)
# SENSOR_MAX_JOB_AGE_SECONDS=600     (an older cycle-ready job is skipped and recorded)
# SENSOR_RUNNER_TIMEOUT_MS=30000

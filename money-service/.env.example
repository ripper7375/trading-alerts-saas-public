# Server
PORT=3002
NODE_ENV=development

# Money-service is called directly from the browser (blueprint §5.4) —
# unlike operation-service's server-side-proxied posture (F30), this needs a
# real CORS allowlist. Vercel production origin(s) only, comma-separated, no
# wildcard.
ALLOWED_ORIGINS=http://localhost:3000

# `money_svc` Postgres role (blueprint §5.1) via PgBouncer — a distinct,
# narrower-scoped role than operation-service's `core_app`. Same production
# Postgres instance, pooled connection string
# (pgbouncer.railway.internal), combined with MONEY_SVC_DB_PASSWORD
# (docs/secret-matrix.md, Session 1-3b). Davin sets this directly on the
# Railway service — never through an agent, never printed.
DATABASE_URL=

# F15 (DECISION-LOG.md): the SAME shared Railway Redis instance
# operation-service's ThrottlerModule already uses — not a dedicated
# instance. Money-service namespaces its own keys/queues under a `money`
# prefix so the two services never collide in the same Redis.
REDIS_URL=redis://localhost:6379

# Shared with the Next.js app and operation-service (docs/secret-matrix.md)
# — same NextAuth JWE verification bridge (F6/F7). Never as a CLI arg, never
# printed.
NEXTAUTH_SECRET=

# Payments — Stripe (docs/secret-matrix.md; already confirmed-live for the
# monolith, same values reused here).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Payments — dLocal. No live values exist yet as of Session 4A-1 (secret
# matrix Gaps section) — Davin supplies real values directly on Railway when
# Slice 4 (write APIs) actually needs them. Deploy-time placeholders only.
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_WEBHOOK_SECRET=
DLOCAL_API_URL=

# Payments — RiseWorks webhook signature (confirmed-live per the secret
# matrix, just undocumented in the 5 catalogued files until now).
RISE_WEBHOOK_SECRET=

# Email — shared Resend account (docs/secret-matrix.md), same as
# operation-service.
RESEND_API_KEY=

# Session 4A-1 CONFIRM deferred this (F31, "no core<->money internal call
# exists yet"); Session 4A-11 activates it for real — the shared secret
# OutboxPublisherCron.deliver() sends as Authorization: Bearer <SVC_TOKEN>
# when POSTing to operation-service's outbox consumer (SvcTokenGuard on
# that side must hold the SAME value). Never as a CLI arg, never printed.
SVC_TOKEN=

# Outbox email worker (Session 4A-8 built the cron, gated OFF; Session 4A-11
# built operation-service's receiving end, still gated OFF here). Both stay
# unset/false until 4A-12's own cutover — see LESSONS-LEARNED.md L31, a
# BUILD session shipping the new side is not itself authorization to flip
# the flag that activates it.
# OUTBOX_PUBLISHER_ENABLED=false
# OUTBOX_PUBLISHER_TARGET_URL=

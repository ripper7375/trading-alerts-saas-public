// Session 4A-2: hand-copied model subset for the 8 cron jobs (blueprint §5.5
// Slice 1). Same "byte-for-byte hand-sync, no automated check" convention
// operation-service/prisma/schema.prisma already carries for User/RefreshToken
// (LESSONS-LEARNED.md L24) — any future change to any of these models in
// prisma/non-market-data/schema.prisma must be mirrored here by hand. This
// file is NEVER a migration source (one shared migration history against one
// shared Postgres, L24) — NEVER run `prisma migrate`/`db push` from this
// package.
//
// Model selection: the 7 models the order named up front (Subscription,
// AffiliateCode, Commission, PaymentBatch, DisbursementTransaction,
// AffiliateRiseAccount, SystemConfig) plus 4 more found only by tracing the
// 8 crons' and their dependency tree's actual `prisma.<model>` calls:
// User, Notification, AffiliateProfile (CONFIRM-phase finding) and
// DisbursementAuditLog (found during this file's own port — used directly by
// lib/disbursement/services/transaction-logger.ts and batch-manager.ts,
// missed at CONFIRM because that pass only traced disbursement-processor.ts's
// own direct prisma calls, not its dependencies' calls one level deeper).
//
// `User` is a NARROW subset (like operation-service's own convention): only
// id/email/name/tier are ever read or written by these 8 crons (verified by
// reading every `prisma.user.*` call site) — no password/2FA/trial/fraud
// fields, which have zero business reason to exist in a money service's
// schema. The other 10 models are money-service's own domain tables per
// blueprint §5.1's `money_svc` grant list, so they're copied in full.
//
// Relations: kept ONLY where a real Prisma relation (`include`, or a
// relation-shaped `where` filter like `disbursementTransaction: null`) is
// actually used somewhere in the ported code — verified by grepping every
// `include:`/relation-filter across the full File 2/6 + File 3/6 dependency
// trees, not assumed from the source schema's own shape. Concretely:
//   - AffiliateProfile <-> Commission, AffiliateProfile <-> AffiliateRiseAccount,
//     Commission <-> DisbursementTransaction, PaymentBatch <-> DisbursementTransaction,
//     PaymentBatch <-> DisbursementAuditLog, AffiliateRiseAccount <-> DisbursementTransaction
//     are all real Prisma relations (commission-aggregator.ts, transaction-service.ts,
//     batch-manager.ts all traverse them).
//   - Commission <-> AffiliateCode and AffiliateCode <-> AffiliateProfile are
//     NOT traversed anywhere (every AffiliateCode touch is by scalar
//     affiliateCodeId/affiliateProfileId only) — declared as bare scalars,
//     no relation object, on both sides.
//   - DisbursementAuditLog.transactionId is a bare scalar (no relation
//     object) — transaction-logger.ts only ever queries/creates it by that
//     scalar field, never via `DisbursementTransaction.auditLogs` include.
//   - Every relation to a model outside this subset (Payment, Account,
//     Alert, Drawing, UserPreferences, Session, RiseWorksWebhookEvent) is
//     dropped, scalar FK kept where the source schema has one.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENUMS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum UserTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum AffiliateStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CodeStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum DistributionReason {
  INITIAL
  MONTHLY
  ADMIN_BONUS
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum NotificationType {
  ALERT
  SUBSCRIPTION
  PAYMENT
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum RiseWorksKycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentBatchStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementProvider {
  RISE      // ARCHIVED 2026-07-25 (Part 19.5, F42) — rows retained, provider deactivated
  MOCK
  WISE      // Part 19.5 — active provider
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
  WARNING
  INFO
}

// Part 19.5 · WISE DISBURSEMENT — hand-mirrored from prisma/non-market-data/schema.prisma
// Session 4A-W2. Convention: FKs to models already in THIS subset (AffiliateProfile,
// PaymentBatch, DisbursementTransaction) are bare scalars, no relation object — no
// money-service code traverses them yet (the actual src/wise/ module is built starting
// 4A-W4), same convention this file already applies to AffiliateCode<->Commission
// above. FKs *within* the new Wise set itself (WiseTransfer<->AffiliateWiseRecipient,
// WiseTransfer<->WiseBatchGroup) are kept as real relations since they're load-bearing
// to the feature these models exist for. Promote the bare-scalar FKs to real relations
// once real traversal code exists and can be grepped, not guessed (L37).
enum WiseRecipientStatus {
  DRAFT
  PENDING_DETAILS
  ACTIVE
  INVALID
  ARCHIVED
}

enum WiseBatchGroupStatus {
  NEW
  COMPLETED
  AWAITING_MANUAL_FUNDING
  FUNDED
  MARKED_FOR_CANCELLATION
  PROCESSING_CANCEL
  CANCELLED
}

enum WiseFundingSource {
  API_BALANCE
  MANUAL_ADMIN
  MANUAL_DETECTED
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MODELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// NARROW subset (see header) — only fields the 8 crons + Slice 2 webhooks
/// read/write. hasUsedThreeDayPlan/threeDayPlanUsedAt added Session 4A-4
/// (File 1/4) — read/written by three-day-validator.service.ts.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  tier      UserTier @default(FREE)

  hasUsedThreeDayPlan Boolean   @default(false)
  threeDayPlanUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// No `user` relation by design — Session 2-3's FK audit dropped it upstream;
/// every ported cron batch-fetches contact users separately by userId
/// (see lib/cron/check-expiring-subscriptions.ts's own comment).
model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  affiliateCodeId String?

  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  dLocalPaymentId     String? @unique
  dLocalPaymentMethod String?
  dLocalCountry       String?
  dLocalCurrency      String?

  planType            String?
  amountUsd           Float
  status              SubscriptionStatus
  expiresAt           DateTime?
  renewalReminderSent Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([affiliateCodeId])
}

/// Added Session 4A-4 (File 1/4, Slice 2 webhooks). No `subscription`
/// relation object — the dLocal webhook only ever assigns `subscriptionId`
/// as a bare scalar (`tx.payment.update({ data: { subscriptionId } })`),
/// never traverses an `include`, matching this schema's own
/// "relation only where actually used" convention (see AffiliateCode).
model Payment {
  id             String  @id @default(cuid())
  userId         String
  subscriptionId String?

  provider String // 'STRIPE' or 'DLOCAL'

  providerPaymentId String @unique
  providerStatus    String

  amount    Decimal
  amountUSD Decimal
  currency  String
  country   String?

  paymentMethod String?

  planType       String? // 'THREE_DAY', 'MONTHLY'
  duration       Int?
  discountCode   String?
  discountAmount Decimal?

  status        String // 'PENDING', 'COMPLETED', 'FAILED', 'REFUNDED', 'CANCELLED'
  failureReason String?

  ipAddress         String?
  deviceFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model AffiliateProfile {
  id     String @id @default(cuid())
  userId String @unique

  fullName String
  country  String

  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?
  tiktokUrl    String?

  paymentMethod  String
  paymentDetails Json

  totalCodesDistributed Int     @default(0)
  totalCodesUsed        Int     @default(0)
  totalEarnings         Decimal @default(0)
  pendingCommissions    Decimal @default(0)
  paidCommissions       Decimal @default(0)

  status           AffiliateStatus @default(PENDING_VERIFICATION)
  verifiedAt       DateTime?
  suspendedAt      DateTime?
  suspensionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kept: both traversed via `include`/relation-filter in commission-aggregator.ts.
  commissions Commission[]
  riseAccount AffiliateRiseAccount?
  // Kept: traversed via `include: { affiliateProfile: ... }` in
  // conversion-processor.service.ts (Session 4A-4, File 2/4).
  affiliateCodes AffiliateCode[]

  @@index([userId])
  @@index([status])
  @@index([country])
}

/// `affiliateProfile` relation object added Session 4A-4 (File 2/4) —
/// conversion-processor.service.ts does `include: { affiliateProfile: ... }`
/// to check the affiliate's ACTIVE status. `commissions` back-relation
/// (AffiliateCode -> Commission) added Session 4A-6 (File 1/3) —
/// commission-report/route.ts's port does `include: { affiliateCode: {
/// select: { code, usedAt } } }` on Commission, which requires the
/// Commission -> AffiliateCode relation object below; Prisma requires the
/// back-relation array declared here too. Previously correctly omitted
/// (Session 4A-4 note) because nothing in scope up to that point traversed
/// it — 4th recorded occurrence of this "narrower-slice omission becomes
/// the next slice's gap" pattern, see LESSONS-LEARNED.md L37.
model AffiliateCode {
  id   String @id @default(cuid())
  code String @unique

  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  discountPercent   Int
  commissionPercent Int

  status             CodeStatus         @default(ACTIVE)
  distributedAt      DateTime           @default(now())
  expiresAt          DateTime
  usedAt             DateTime?
  cancelledAt        DateTime?
  distributionReason DistributionReason @default(MONTHLY)

  usedBy         String?
  subscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions Commission[]

  @@index([affiliateProfileId])
  @@index([status])
  @@index([expiresAt])
  @@index([code])
}

model Commission {
  id String @id @default(cuid())

  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  // Relation object added Session 4A-6 (File 1/3) — see AffiliateCode's own
  // note above.
  affiliateCodeId String
  affiliateCode   AffiliateCode @relation(fields: [affiliateCodeId], references: [id])

  userId         String
  subscriptionId String?

  grossRevenue     Decimal
  discountAmount   Decimal
  netRevenue       Decimal
  commissionAmount Decimal

  status      CommissionStatus @default(PENDING)
  earnedAt    DateTime         @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  paymentBatchId   String?
  paymentMethod    String?
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kept: used as a relation-filter (`disbursementTransaction: null`) in
  // commission-aggregator.ts to find not-yet-disbursed commissions.
  disbursementTransaction DisbursementTransaction?

  @@index([affiliateProfileId])
  @@index([status])
  @@index([earnedAt])
  @@index([paidAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type     NotificationType
  title    String
  body     String
  priority NotificationPriority @default(MEDIUM)

  read   Boolean   @default(false)
  readAt DateTime?

  link String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RISEWORKS DISBURSEMENT SYSTEM (Part 19) — ARCHIVED 2026-07-25 (Part 19.5, F42)
// Provider deactivated, NOT removed. Tables, rows, enum value and relations are
// retained verbatim so RiseWorks can be restored. Superseded by the WISE* models
// below. Do not drop, rename or backfill anything in this block.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AffiliateRiseAccount {
  id String @id @default(cuid())

  affiliateProfileId String           @unique
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  riseId String @unique
  email  String

  kycStatus      RiseWorksKycStatus @default(PENDING)
  kycCompletedAt DateTime?

  invitationSentAt     DateTime?
  invitationAcceptedAt DateTime?

  lastSyncAt DateTime?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kept: required by Prisma to pair with DisbursementTransaction's own
  // `affiliateRiseAccount` relation (batch-manager.ts, transaction-service.ts),
  // even though nothing traverses it from this side.
  disbursementTransactions DisbursementTransaction[]

  @@index([affiliateProfileId])
  @@index([riseId])
  @@index([kycStatus])
}

model PaymentBatch {
  id String @id @default(cuid())

  batchNumber String @unique

  paymentCount Int     @default(0)
  totalAmount  Decimal @default(0)
  currency     String  @default("USD")

  provider DisbursementProvider

  status PaymentBatchStatus @default(PENDING)

  scheduledAt DateTime?
  executedAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  errorMessage String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Kept: both traversed via `include` in batch-manager.ts (getBatchById,
  // getBatchByNumber, getBatchesWithSummary's `_count`).
  transactions DisbursementTransaction[]
  auditLogs    DisbursementAuditLog[]

  @@index([status])
  @@index([scheduledAt])
  @@index([provider])
  @@index([batchNumber])
}

model DisbursementTransaction {
  id String @id @default(cuid())

  batchId String
  batch   PaymentBatch @relation(fields: [batchId], references: [id])

  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id])

  transactionId String  @unique
  providerTxId  String?

  provider DisbursementProvider

  affiliateRiseAccountId String?
  affiliateRiseAccount   AffiliateRiseAccount? @relation(fields: [affiliateRiseAccountId], references: [id])
  payeeRiseId            String?

  amount          Decimal
  amountRiseUnits BigInt?
  currency        String  @default("USD")

  status DisbursementTransactionStatus @default(PENDING)

  retryCount  Int       @default(0)
  lastRetryAt DateTime?

  errorMessage String?
  metadata     Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  failedAt    DateTime?

  @@index([batchId])
  @@index([commissionId])
  @@index([status])
  @@index([providerTxId])
  @@index([createdAt])
}

/// Added Session 4A-4 (File 1/4, Slice 2 webhooks). `transactionId` is a
/// bare scalar (no relation object) — the RiseWorks webhook route creates
/// these rows standalone and never sets/traverses a `transaction` relation,
/// same convention as DisbursementAuditLog.transactionId below.
model RiseWorksWebhookEvent {
  id String @id @default(cuid())

  transactionId String?

  eventType String
  provider  DisbursementProvider

  payload Json

  signature String?
  hash      String?
  verified  Boolean @default(false)

  processed    Boolean   @default(false)
  processedAt  DateTime?
  errorMessage String?

  receivedAt DateTime @default(now())

  @@index([transactionId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
}

/// `transaction`/`DisbursementTransaction.auditLogs` pair intentionally
/// omitted — transaction-logger.ts only ever queries/creates by the scalar
/// `transactionId`, never via a `DisbursementTransaction.auditLogs` include
/// (unlike `batchId`, which batch-manager.ts DOES include through
/// `PaymentBatch.auditLogs` — that pair is kept below).
model DisbursementAuditLog {
  id String @id @default(cuid())

  transactionId String?

  batchId String?
  batch   PaymentBatch? @relation(fields: [batchId], references: [id])

  action String
  actor  String?

  status AuditLogStatus

  details   Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([batchId])
  @@index([action])
  @@index([createdAt])
}

/// System-wide configuration settings (admin-tunable, e.g. the disbursement
/// processor's `affiliate_commission_approval_days` window).
model SystemConfig {
  id String @id @default(cuid())

  key   String @unique
  value String

  valueType   String  @default("string")
  description String?
  category    String
  updatedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([key])
}

/// One Wise recipient (beneficiary) per affiliate. PII-minimising by design:
/// the authoritative bank details live at Wise, never here. See design §7.4.
/// No `affiliateProfile` relation object — scalar FK only (see convention
/// note above).
model AffiliateWiseRecipient {
  id                 String @id @default(cuid())

  affiliateProfileId String @unique

  wiseRecipientId String? @unique
  wiseProfileId   String

  accountHolderName String
  targetCurrency    String
  recipientCountry  String
  legalType         String
  requirementsType  String

  accountTail        String?
  detailsFingerprint String?

  status          WiseRecipientStatus @default(DRAFT)
  lastValidatedAt DateTime?
  invalidReason   String?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfers WiseTransfer[]

  @@index([wiseRecipientId])
  @@index([status])
  @@index([targetCurrency])
}

/// The Wise-side half of a DisbursementTransaction. 1:1. No
/// `disbursementTransaction` relation object — scalar FK only (see
/// convention note above); `wiseTransfer` back-relation therefore not added
/// to DisbursementTransaction above either.
model WiseTransfer {
  id String @id @default(cuid())

  disbursementTransactionId String @unique

  affiliateWiseRecipientId String?
  affiliateWiseRecipient   AffiliateWiseRecipient? @relation(fields: [affiliateWiseRecipientId], references: [id])

  wiseBatchGroupId String?
  wiseBatchGroup   WiseBatchGroup? @relation(fields: [wiseBatchGroupId], references: [id])

  wiseTransferId         String  @unique
  wiseQuoteId            String
  customerTransactionId  String  @unique
  reference              String?

  sourceCurrency String
  sourceValue    Decimal
  targetCurrency String
  targetValue    Decimal
  rate           Decimal
  feeAmount      Decimal @default(0)
  feeBearer      String

  currentState         String    @default("created")
  previousState        String?
  lastEventOccurredAt  DateTime?
  stateHistory         Json?

  payoutFailureCode        String?
  payoutFailureDescription String?
  hasActiveIssues          Boolean @default(false)

  balanceAppliedAt  DateTime?
  balanceRevertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wiseBatchGroupId])
  @@index([currentState])
  @@index([lastEventOccurredAt])
  @@index([payoutFailureCode])
}

/// The Wise-side half of a PaymentBatch. 1:1. Carries the funding gate. No
/// `paymentBatch` relation object — scalar FK only (see convention note
/// above).
model WiseBatchGroup {
  id String @id @default(cuid())

  paymentBatchId String @unique

  wiseBatchGroupId String @unique
  wiseProfileId    String
  wiseVersion      Int
  wiseName         String

  sourceCurrency    String
  transferCount     Int     @default(0)
  totalSourceAmount Decimal @default(0)

  status WiseBatchGroupStatus @default(NEW)

  payInDetails    Json?
  fundingSource   WiseFundingSource?
  fundedAt        DateTime?
  fundedByUserId  String?
  fundingEvidence Json?
  completedAt     DateTime?
  cancelledAt     DateTime?
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfers WiseTransfer[]

  @@index([status])
  @@index([wiseBatchGroupId])
  @@index([createdAt])
}

/// Every inbound Wise webhook delivery. THE dedupe + replay table.
model WiseWebhookEvent {
  id String @id @default(cuid())

  deliveryId     String  @unique
  subscriptionId String?
  eventType      String
  schemaVersion  String?

  resourceType   String?
  wiseResourceId String?
  currentState   String?
  previousState  String?
  occurredAt     DateTime?
  sentAt         DateTime?

  payload            Json
  rawSignature       String?
  signatureVerified  Boolean @default(false)
  isTestNotification Boolean @default(false)

  processed     Boolean   @default(false)
  processedAt   DateTime?
  skippedReason String?
  errorMessage  String?
  attemptCount  Int       @default(0)

  receivedAt DateTime @default(now())

  @@index([eventType])
  @@index([wiseResourceId])
  @@index([processed])
  @@index([occurredAt])
  @@index([receivedAt])
}

/// Wise webhook subscriptions we own, so cutover/rollback is auditable.
model WiseWebhookSubscription {
  id                 String  @id @default(cuid())
  wiseSubscriptionId String  @unique
  scopeDomain        String
  scopeId            String
  eventType          String
  schemaVersion      String
  deliveryUrl        String
  environment        String
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  @@index([eventType])
  @@index([active])
}

# Frontend-Backend Environment Variable Sync Checklist
# =====================================================
# This file documents which env vars need to be synced between
# the monolith (root) and the modular frontend (frontend/)

# ===== MUST SYNC (same values) =====
NEXTAUTH_SECRET=               # Must match for session compatibility
# Copy from root .env to frontend/.env

# ===== DIFFERENT VALUES (per deployment) =====
NEXTAUTH_URL=                  # Different URL per deployment
# Root: https://trading-alerts.vercel.app
# Frontend: https://trading-alerts-frontend-xyz.vercel.app

# ===== FRONTEND ONLY =====
NEXT_PUBLIC_API_URL=           # Backend API URL
# Set to: https://api.trading-alerts.railway.app (after Step 5)
# Or: http://localhost:5000 (for local development)
# Or: https://trading-alerts.vercel.app (use monolith during transition)

NEXT_PUBLIC_DEPLOYMENT_TYPE=modular-frontend
NEXT_PUBLIC_BACKEND_VERSION=v2

# ===== SHARED (copy to both) =====
DATABASE_URL=                  # PostgreSQL connection
GOOGLE_CLIENT_ID=             # Google OAuth
GOOGLE_CLIENT_SECRET=         # Google OAuth
TWITTER_CLIENT_ID=            # Twitter OAuth
TWITTER_CLIENT_SECRET=        # Twitter OAuth
RESEND_API_KEY=               # Email service
RESEND_FROM_EMAIL=            # Email sender

# ===== BACKEND ONLY (do NOT copy to frontend in Step 5+) =====
# These will only be in the backend (Railway) after Step 5
# STRIPE_SECRET_KEY            # Backend only (payment processing)
# STRIPE_WEBHOOK_SECRET        # Backend only (webhooks)
# REDIS_URL                    # Backend only (caching)
# POSTGRESQL_URI               # Backend only (direct DB access)

# ===== MIGRATION NOTES =====
# Step 4 (Current): Frontend uses same env vars as monolith
# Step 5+: Backend moves to Railway, frontend calls backend API
#
# During Step 4-5 transition:
# - Frontend and monolith share DATABASE_URL
# - Frontend and monolith share all auth credentials
# - This ensures session compatibility during migration
#
# After Step 5 complete:
# - Frontend only has auth credentials and API URL
# - Backend (Railway) has all service credentials
# - Frontend calls backend API for all data operations

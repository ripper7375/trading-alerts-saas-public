# ==========================================
# Trading Alerts SaaS - Frontend Environment Variables
# Multi-Backend Architecture (Simplified - 2 backends)
# ==========================================

# ==========================================
# API ENDPOINTS (Simplified - Only 2!)
# ==========================================

# Backend Stack A (Main CRUD, Auth, Billing) - Railway
# Handles: User, Profile, Subscription, Billing, Admin, Affiliate, Payments
# Parts: 2-9, 12-14, 17, 19
NEXT_PUBLIC_API_A_URL=https://stack-a.railway.app

# Backend Stack B (Async Workers, Analytics, Market Data Gateway) - Railway
# Handles: Watchlist, Alerts, Notifications, Confluence, Leader Board
# Also proxies market data requests to Stack C
# Parts: 10, 11, 15, 20-23
NEXT_PUBLIC_API_B_URL=https://stack-b.railway.app

# ⚠️ NO NEXT_PUBLIC_API_C_URL - Frontend doesn't access Stack C directly!
# Stack B acts as a proxy/gateway to Stack C for market data requests.
# This reduces complexity by ~35% and improves security.

# ==========================================
# AUTHENTICATION (NextAuth)
# ==========================================

# Base URL for NextAuth (should match your Vercel deployment URL)
NEXTAUTH_URL=https://your-app.vercel.app

# Secret for NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here

# ==========================================
# DEVELOPMENT MODE
# ==========================================

# Enable Mock Service Worker (MSW) for local development
# Set to 'true' to use mocks, 'false' to use real backends
NEXT_PUBLIC_USE_MOCKS=false

# ==========================================
# STRIPE (Payment Integration)
# ==========================================

# Stripe publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# ==========================================
# ANALYTICS & MONITORING
# ==========================================

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN (optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable beta features
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# ==========================================
# NOTES
# ==========================================

# Architecture Benefits:
# ✅ Only 2 API clients needed (not 3)
# ✅ Only 2 environment variables for backends
# ✅ Stack C not exposed to internet (more secure)
# ✅ Stack B caches market data from Stack C
# ✅ Stack B validates tier permissions before accessing Stack C
# ✅ Simpler CORS configuration
# ✅ ~35% less complexity overall

# Development vs Production:
# - Development: Can point to localhost
#   NEXT_PUBLIC_API_A_URL=http://localhost:3001
#   NEXT_PUBLIC_API_B_URL=http://localhost:3002
#
# - Staging: Point to Railway staging deployments
#   NEXT_PUBLIC_API_A_URL=https://stack-a-staging.railway.app
#   NEXT_PUBLIC_API_B_URL=https://stack-b-staging.railway.app
#
# - Production: Point to Railway production deployments
#   NEXT_PUBLIC_API_A_URL=https://stack-a.railway.app
#   NEXT_PUBLIC_API_B_URL=https://stack-b.railway.app

# Vercel Deployment:
# Set these environment variables in your Vercel project settings:
# Settings → Environment Variables → Add each variable
#
# Remember to set different values for:
# - Development (optional)
# - Preview (staging)
# - Production

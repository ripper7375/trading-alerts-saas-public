# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TRADING ALERTS SAAS - FRONTEND ENVIRONMENT VARIABLES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. API CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# API Base URL
# Controls where the frontend sends API requests
#
# Step 4 (Current - Next.js API Routes):
#   Leave empty or set to "/api"
#   Frontend will use Next.js API routes (/api/*)
#
# Step 5+ (Future - Nest.js on Railway):
#   Set to Nest.js deployment URL
#   Frontend will call external Nest.js API
#
# Examples:
#   NEXT_PUBLIC_API_URL=                              (uses Next.js API routes)
#   NEXT_PUBLIC_API_URL=/api                          (uses Next.js API routes)
#   NEXT_PUBLIC_API_URL=http://localhost:3001         (local Nest.js development)
#   NEXT_PUBLIC_API_URL=https://your-api.railway.app  (production Nest.js)
#
NEXT_PUBLIC_API_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 2. AUTHENTICATION (NextAuth.js)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# NextAuth URL (must match your deployment URL exactly)
# Production: https://your-frontend.vercel.app
# Development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (generate with: openssl rand -base64 32)
# IMPORTANT: Keep this secret! Don't commit to git!
NEXTAUTH_SECRET=your_generated_secret_here_minimum_32_characters

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 3. OAUTH PROVIDERS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter OAuth (from Twitter Developer Portal)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OAuth (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 4. EMAIL SERVICE (Resend)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Resend API Key (from resend.com dashboard)
# Used for sending verification emails
RESEND_API_KEY=

# Sender email (optional, defaults to onboarding@resend.dev)
# If domain verified: noreply@yourdomain.com
# If not verified: onboarding@resend.dev
RESEND_FROM_EMAIL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 5. DATABASE (PostgreSQL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Database URL (PostgreSQL connection string)
# Note: After Step 5 (Nest.js migration), frontend may not need this
#       if all database access is through Nest.js API
DATABASE_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 6. ANALYTICS & MONITORING (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 7. FEATURE FLAGS (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable/disable specific OAuth providers
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_TWITTER_AUTH=true
NEXT_PUBLIC_ENABLE_LINKEDIN_AUTH=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SETUP INSTRUCTIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in all required values (marked above)
#
# 3. Never commit .env.local to git (already in .gitignore)
#
# 4. For production (Vercel):
#    - Set these in Vercel Dashboard → Settings → Environment Variables
#    - Select "Production" environment
#    - Redeploy after adding variables
#
# 5. For authentication setup:
#    - Follow: monolith-to-modular-monolith-migration/COMPLETE_AUTH_FIX_GUIDE.md
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

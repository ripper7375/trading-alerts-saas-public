  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://srtfopblzhtesbvaeyct.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "shared-app-engine",
      "version": "0.1.0",
      "title": "Shared App Engine"

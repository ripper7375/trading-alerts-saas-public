# Part 6 Environment Variables (Backed up for rollback)
# Backup Date: 2026-01-07
# Purpose: Restore these variables if rolling back to Flask MT5 service

# Flask MT5 Service URL
MT5_SERVICE_URL=http://localhost:5001

# Alternative MT5 API URL (used in some parts of codebase)
MT5_API_URL=http://localhost:5000

# MT5 API Authentication Key
MT5_API_KEY=your-api-key-here

# MT5 Admin API Key (if applicable)
MT5_ADMIN_API_KEY=your-admin-key-here

# Flask Port (optional if different from default)
FLASK_PORT=5001

# MT5 Credentials (from main .env.example)
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

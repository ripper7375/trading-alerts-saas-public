# ============================================================================
# AIDER AI Files
# ============================================================================
# Allow .aider.conf.yml but ignore everything else
.aider.tags.cache.v4
.aider.chat.history.md
.aider.input.history

# Allow .aider.conf.yml to be committed (configuration file)
!.aider.conf.yml

# Local staging packages
DEPLOY_TO_CONTABO_VPS_READY/
DEPLOY_TO_CONTABO_VPS_READY.zip

# ============================================================================
# ENVIRONMENT VARIABLES (CRITICAL - NEVER COMMIT SECRETS!)
# ============================================================================
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging

# Keep the template!
!.env.example

# ============================================================================
# NODE.JS / NPM / PNPM
# ============================================================================
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
# A stray npm lockfile at the repo root. The root is pnpm-managed; the service
# folders (money-service, operation-service, railway-gateway, ...) keep their
# own tracked lockfiles, so this rule is anchored to the root only.
/package-lock.json

# ============================================================================
# NEXT.JS
# ============================================================================
.next/
out/
build/
dist/
.vercel

# Next.js cache
.next/cache


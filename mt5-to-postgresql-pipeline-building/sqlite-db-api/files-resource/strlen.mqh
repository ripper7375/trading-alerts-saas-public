#property copyright "Copyright © 2006-2014"
#property version   "1.00"

#import "msvcrt.dll"
int strlen(int src);
int strlen(long src);
#import

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int strlen(long src)
{
   if(_IsX64)
      return(msvcrt::strlen(src));
   else
      return(msvcrt::strlen((int)src));
}
//+------------------------------------------------------------------+

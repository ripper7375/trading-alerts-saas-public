{
  "name": "trading-alerts-saas-v7",
  "version": "0.1.0",
  "description": "Trading Alerts SaaS V7 - Real-time trading alerts with fractal analysis",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "rimraf .next tsconfig.tsbuildinfo node_modules/.prisma && npm run prisma:generate:market-data && npm run prisma:generate:non-market-data",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "npm run prisma:generate:market-data && npm run prisma:generate:non-market-data && tsc --noEmit",
    "test": "jest",
    "test:quick": "jest --bail --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=json-summary --coverageReporters=lcov",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --silent",
    "coverage:report": "node scripts/check-coverage.js",
    "coverage:full": "npm run test:coverage && npm run coverage:report",
    "test:api": "newman run postman/collections/nextjs-api.postman_collection.json -e postman/environments/local.postman_environment.json",
    "test:api:flask": "newman run postman/collections/flask-mt5.postman_collection.json -e postman/environments/local.postman_environment.json",
    "test:api:all": "npm run test:api && npm run test:api:flask",
    "test:integration": "jest __tests__/integration --ci --coverage=false",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:group-a": "playwright test --config=e2e/playwright.config.ts --grep 'Path 1|Path 2|Path 3'",
    "test:e2e:group-b": "playwright test --config=e2e/playwright.config.ts --grep 'Path 4|Path 5|Path 6|Path 7'",
    "test:e2e:ci": "playwright test --config=e2e/playwright.config.ts --reporter=github,html",
    "playwright:install": "playwright install --with-deps",
    "test:load:health": "k6 run k6-tests/01-health-check.js",
    "test:load:auth": "k6 run k6-tests/02-auth-load.js",
    "test:load:alerts": "k6 run k6-tests/03-alerts-api-load.js",
    "test:load:checkout": "k6 run k6-tests/04-checkout-load.js",
    "test:load:websocket": "k6 run k6-tests/05-websocket-load.js",
    "test:load:spike": "k6 run k6-tests/06-spike-test.js",
    "test:load:all": "npm run test:load:health && npm run test:load:auth && npm run test:load:alerts && npm run test:load:checkout",
    "test:mt5:verify": "tsx scripts/verify-sync-deployment.ts",
    "test:mt5:deployment": "tsx scripts/test-mt5-deployment.ts",
    "test:mt5:monitor": "tsx scripts/monitor-mt5-pipeline.ts",
    "test:mt5:all": "npm run test:mt5:verify && npm run test:mt5:deployment && npm run test:mt5:monitor",
    "worker:alerts": "tsx scripts/alert-worker.ts",
    "e2e:setup": "bash scripts/setup-e2e.sh",
    "health:check": "node scripts/health-check-ui.js",
    "health:check:http": "node scripts/health-check-ui.js --http",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run validate:types && npm run validate:lint && npm run validate:format && npm run validate:policies",
    "validate:types": "echo '🔍 Checking TypeScript types...' && tsc --noEmit",
    "validate:lint": "echo '🔍 Checking code quality...' && next lint --max-warnings 0",
    "validate:format": "echo '🔍 Checking code formatting...' && prettier --check .",
    "validate:policies": "echo '🔍 Checking policy compliance...' && node scripts/validate-file.js --all",
    "validate:file": "node scripts/validate-file.js",
    "sync:frontend": "bash scripts/sync-frontend.sh",
    "sync:check": "node scripts/check-sync-needed.js",
    "sync:all": "npm run sync:frontend && npm run validate",
    "fix": "npm run lint:fix && npm run format",
    "prisma:generate": "npm run prisma:generate:market-data && npm run prisma:generate:non-market-data",
    "prisma:generate:market-data": "prisma generate --schema=prisma/market-data/schema.prisma",
    "prisma:generate:non-market-data": "prisma generate --schema=prisma/non-market-data/schema.prisma",
    "prisma:migrate": "prisma migrate deploy",
    "db:generate": "npm run prisma:generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "postinstall": "npm run prisma:generate",
    "security:audit": "pnpm audit",
    "security:audit:prod": "pnpm audit --prod",
    "security:audit:json": "pnpm audit --json > reports/security/pnpm-audit-latest.json",
    "security:check": "pnpm audit --prod && echo '✅ No high/critical vulnerabilities in production dependencies'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'ESLINT_USE_FLAT_CONFIG=false eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-email/components": "^1.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.303.0",
    "next": "15.5.20",
    "next-auth": "^4.24.5",
    "next-themes": "^0.4.4",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.49.0",
    "redis": "^4.7.0",
    "resend": "^2.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "stripe": "^14.10.0",
    "swr": "^2.3.8",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@next/swc-win32-x64-msvc": "15.5.20",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.2.17",
    "@vercel/analytics": "^1.1.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.20",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^16.2.7",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "7.8.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.0",
    "tsx": "4.23.1",
    "typescript": "^5.4.0",
    "undici": "^6.23.0"
  },
  "overrides": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "node-forge": "^1.3.2",
    "qs": "^6.14.2",
    "jose": "^4.15.5",
    "ajv": "^6.14.0"
  },
  "pnpm": {
    "overrides": {
      "node-forge": "^1.3.2",
      "qs": "^6.14.2",
      "jose": "^4.15.5",
      "nodemailer": "^7.0.11",
      "preact": "^10.27.3",
      "lodash": "^4.17.23",
      "ajv": "^6.14.0",
      "minimatch@<3.1.3": "3.1.4",
      "minimatch@>=9.0.0 <9.0.6": "9.0.7",
      "next": "15.5.20",
      "@next/swc-win32-x64-msvc": "15.5.20"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "trading",
    "alerts",
    "saas",
    "nextjs",
    "fractal-analysis",
    "mt5",
    "forex"
  ],
  "author": "Trading Alerts Team",
  "license": "MIT"
}

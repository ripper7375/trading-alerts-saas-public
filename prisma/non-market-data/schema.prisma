generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/non-market-client"
}

datasource db {
  provider = "postgresql"
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENUMS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum UserTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum TrialStatus {
  NOT_STARTED
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum AffiliateStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CodeStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum DistributionReason {
  INITIAL
  MONTHLY
  ADMIN_BONUS
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum FraudAlertStatus {
  PENDING
  REVIEWED
  DISMISSED
  BLOCKED
}

enum FraudAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MODELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?  // Nullable for OAuth-only users
  image         String?
  emailVerified DateTime? // CRITICAL for verified-only OAuth linking
  tier          UserTier @default(FREE)
  role          String   @default("USER")
  isActive      Boolean  @default(true)

  // Affiliate System (Unified Auth)
  isAffiliate   Boolean  @default(false)  // Can be both SaaS user AND affiliate

  // General Trial Period Management (7-day PRO trial)
  trialStatus       TrialStatus  @default(NOT_STARTED)
  trialStartDate    DateTime?    // When user started 7-day trial
  trialEndDate      DateTime?    // When trial expires (trialStartDate + 7 days)
  trialConvertedAt  DateTime?    // When trial converted to paid subscription
  trialCancelledAt  DateTime?    // When user cancelled trial
  hasUsedFreeTrial  Boolean      @default(false)  // Prevent multiple 7-day trials

  // Stripe Trial fields (Part 18: Anti-abuse)
  hasUsedStripeTrial      Boolean  @default(false)
  stripeTrialStartedAt    DateTime?

  // dLocal 3-day plan fields (Part 18: Anti-abuse)
  hasUsedThreeDayPlan     Boolean  @default(false)
  threeDayPlanUsedAt      DateTime?

  // Fraud detection fields
  signupIP          String?
  lastLoginIP       String?
  deviceFingerprint String?

  // Email verification and password reset
  verificationToken String? @unique
  resetToken        String? @unique
  resetTokenExpiry  DateTime?

  // Two-Factor Authentication (TOTP)
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?  // Encrypted TOTP secret
  twoFactorBackupCodes String?  // JSON array of hashed backup codes
  twoFactorVerifiedAt  DateTime? // When 2FA was successfully enabled

  accounts          Account[]
  alerts            Alert[]
  drawings          Drawing[]
  preferences       UserPreferences?   // User preferences (settings)

  sessions          Session[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([tier])
  @@index([isAffiliate])
  @@index([trialStatus])
  @@index([trialEndDate])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Extended session tracking for device/location monitoring
/// Separate from NextAuth Session to preserve auth functionality
model UserSession {
  id            String   @id @default(cuid())
  userId        String

  /// Session metadata
  userAgent     String?  // Full user agent string
  ipAddress     String?  // Client IP address
  deviceType    String?  // desktop, mobile, tablet
  browser       String?  // Chrome, Safari, Firefox, etc.
  browserVersion String? // Browser version
  os            String?  // MacOS, Windows, iOS, Android
  osVersion     String?  // OS version

  /// Geolocation (from IP)
  country       String?  // Country code (US, UK, etc.)
  city          String?  // City name
  region        String?  // State/region

  /// Session state
  isActive      Boolean  @default(true)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  /// Link to NextAuth session token (for revoking)
  sessionToken  String?  @unique

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([lastActiveAt])
  @@map("user_sessions")
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOGIN HISTORY & SECURITY ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum SecurityAlertType {
  NEW_DEVICE_LOGIN
  PASSWORD_CHANGED
  EMAIL_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SUSPICIOUS_LOGIN
  ACCOUNT_LOCKED
}

/// Tracks all login attempts for security monitoring
model LoginHistory {
  id            String       @id @default(cuid())
  userId        String

  /// Login details
  status        LoginStatus
  provider      String       // 'credentials', 'google', 'twitter', 'linkedin'

  /// Device/browser info
  userAgent     String?
  deviceType    String?      // desktop, mobile, tablet
  browser       String?
  browserVersion String?
  os            String?
  osVersion     String?

  /// Geolocation (from IP)
  ipAddress     String?
  country       String?
  city          String?
  region        String?

  /// Device fingerprint for new device detection
  deviceFingerprint String?
  isNewDevice   Boolean      @default(false)

  /// Failure info
  failureReason String?

  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([createdAt])
  @@map("login_history")
}

/// Security alerts sent to users
model SecurityAlert {
  id            String             @id @default(cuid())
  userId        String

  /// Alert details
  type          SecurityAlertType
  title         String
  message       String

  /// Context
  ipAddress     String?
  deviceInfo    String?
  location      String?

  /// Status
  emailSent     Boolean            @default(false)
  emailSentAt   DateTime?
  read          Boolean            @default(false)
  readAt        DateTime?

  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([type])
  @@index([createdAt])
  @@map("security_alerts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Preferences stored as JSON for flexibility
  preferences Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  expiresAt DateTime

  confirmedAt  DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([status])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique

  // Affiliate tracking
  affiliateCodeId    String?  // Track which affiliate code was used (nullable)

  // Stripe fields (nullable for dLocal subscriptions)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // dLocal fields (nullable for Stripe subscriptions)
  dLocalPaymentId        String?  @unique
  dLocalPaymentMethod    String?  // 'UPI', 'PAYTM', 'GOPAY', etc.
  dLocalCountry          String?  // 'IN', 'ID', 'PK', etc.
  dLocalCurrency         String?  // 'INR', 'IDR', 'PKR', etc.

  // Common fields
  planType               String?  // 'MONTHLY', 'THREE_DAY' (dLocal only)
  amountUsd              Float
  status                 SubscriptionStatus
  expiresAt              DateTime? // Explicit expiry date (critical for dLocal)
  renewalReminderSent    Boolean  @default(false)

  payments               Payment[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([affiliateCodeId])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Alert configuration
  name        String?
  symbol      String
  timeframe   String
  condition   String   // JSON string for complex conditions
  alertType   String   @default("PRICE_TOUCH_LINE")

  // Alert state
  isActive    Boolean  @default(true)
  lastTriggered DateTime?
  triggerCount Int     @default(0)

  // Optional link to a chart drawing (line-touch alerts)
  drawingAlert DrawingAlert?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([symbol, timeframe])
  @@index([isActive])
}

// V8 migration (2026-07): Watchlist and WatchlistItem models removed —
// watchlists were eliminated from the product for all tiers.
// See migration 20260706000000_drop_watchlists.

model Payment {
  id                 String   @id @default(cuid())
  userId             String
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])

  // Payment Provider
  provider           String   // 'STRIPE' or 'DLOCAL'

  // Transaction Details
  providerPaymentId  String   @unique
  providerStatus     String

  // Amount and Currency
  amount             Decimal
  amountUSD          Decimal
  currency           String
  country            String?
  paymentMethod      String?

  // Additional Data
  planType           String?  // 'THREE_DAY', 'MONTHLY'
  duration           Int?     // Days (3 or 30)
  discountCode       String?
  discountAmount     Decimal?

  // Status and Timestamps
  status             String   // 'PENDING', 'COMPLETED', 'FAILED', 'REFUNDED', 'CANCELLED'
  failureReason      String?

  // Fraud Detection Metadata
  ipAddress          String?
  deviceFingerprint  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model FraudAlert {
  id                String   @id @default(cuid())
  userId            String

  // Alert Details
  pattern           String   // '3DAY_PLAN_REUSE', 'MULTIPLE_FAILED_PAYMENTS', 'VELOCITY_LIMIT', 'IP_MISMATCH', etc.
  severity          FraudAlertSeverity
  status            FraudAlertStatus @default(PENDING)
  description       String

  // Payment Context (for payment-related fraud)
  country           String?
  paymentMethod     String?
  amount            Decimal?
  currency          String?

  // Detection Metadata
  ipAddress         String?
  deviceFingerprint String?
  additionalData    Json?    // Flexible field for extra context

  // Admin Review
  reviewedBy        String?  // Admin user ID who reviewed
  reviewedAt        DateTime?
  resolution        String?  // 'FALSE_POSITIVE', 'WARNING_SENT', 'BLOCKED', etc.
  notes             String?  // Admin notes

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([pattern])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AFFILIATE MARKETING SYSTEM (Unified Auth)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AffiliateProfile {
  id                String   @id @default(cuid())
  userId            String   @unique

  // Affiliate Info
  fullName          String
  country           String

  // Social Media (optional)
  facebookUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  youtubeUrl        String?
  tiktokUrl         String?

  // Payment Preferences
  paymentMethod     String   // 'BANK_TRANSFER', 'CRYPTO_USDT', 'PAYPAL', 'LOCAL_WALLET'
  paymentDetails    Json     // Flexible field for payment info

  // Stats
  totalCodesDistributed  Int      @default(0)
  totalCodesUsed         Int      @default(0)
  totalEarnings          Decimal  @default(0)
  pendingCommissions     Decimal  @default(0)
  paidCommissions        Decimal  @default(0)

  // Status
  status            AffiliateStatus   @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  affiliateCodes    AffiliateCode[]
  commissions       Commission[]
  riseAccount       AffiliateRiseAccount?  // Part 19: RiseWorks account for payouts
  wiseRecipient     AffiliateWiseRecipient?  // Part 19.5: Wise recipient for payouts

  @@index([userId])
  @@index([status])
  @@index([country])
}

model AffiliateCode {
  id               String   @id @default(cuid())
  code             String   @unique

  // Ownership
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  // Configuration
  discountPercent  Int      // 0-50%
  commissionPercent Int     // 0-50%

  // Lifecycle
  status           CodeStatus   @default(ACTIVE)
  distributedAt    DateTime     @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  cancelledAt      DateTime?
  distributionReason DistributionReason @default(MONTHLY)

  // Usage tracking
  usedBy           String?  // userId (if redeemed)
  subscriptionId   String?  // subscription created from this code

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commissions      Commission[]

  @@index([affiliateProfileId])
  @@index([status])
  @@index([expiresAt])
  @@index([code])
}

model Commission {
  id                 String   @id @default(cuid())

  // Ownership
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  affiliateCodeId    String
  affiliateCode      AffiliateCode @relation(fields: [affiliateCodeId], references: [id])

  // Transaction
  userId             String   // SaaS user who upgraded
  subscriptionId     String?  // Subscription created

  // Amounts
  grossRevenue       Decimal  // Full subscription amount
  discountAmount     Decimal  // Discount given to user
  netRevenue         Decimal  // After discount
  commissionAmount   Decimal  // Affiliate earns this

  // Status
  status             CommissionStatus @default(PENDING)
  earnedAt           DateTime @default(now())
  approvedAt         DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?

  // Payment tracking
  paymentBatchId     String?
  paymentMethod      String?
  paymentReference   String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Part 19: Disbursement relationship
  disbursementTransaction DisbursementTransaction?

  @@index([affiliateProfileId])
  @@index([status])
  @@index([earnedAt])
  @@index([paidAt])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NOTIFICATIONS SYSTEM (Part 15)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum NotificationType {
  ALERT
  SUBSCRIPTION
  PAYMENT
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

model Notification {
  id        String   @id @default(cuid())
  userId    String

  // Notification content
  type      NotificationType
  title     String
  body      String
  priority  NotificationPriority @default(MEDIUM)

  // Read status
  read      Boolean  @default(false)
  readAt    DateTime?

  // Optional link to related resource
  link      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RISEWORKS DISBURSEMENT SYSTEM (Part 19) — ARCHIVED 2026-07-25 (Part 19.5, F42)
// Provider deactivated, NOT removed. Tables, rows, enum value and relations are
// retained verbatim so RiseWorks can be restored. Superseded by the WISE* models
// below. Do not drop, rename or backfill anything in this block.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum RiseWorksKycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentBatchStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementProvider {
  RISE      // ARCHIVED 2026-07-25 (Part 19.5, F42) — rows retained, provider deactivated
  MOCK
  WISE      // Part 19.5 — active provider
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
  WARNING
  INFO
}

model AffiliateRiseAccount {
  id                   String   @id @default(cuid())

  // Link to existing Part 17 AffiliateProfile
  affiliateProfileId   String   @unique
  affiliateProfile     AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  // RiseWorks Account Info
  riseId               String   @unique  // Blockchain address
  email                String

  // KYC Status
  kycStatus            RiseWorksKycStatus @default(PENDING)
  kycCompletedAt       DateTime?

  // Invitation Tracking
  invitationSentAt     DateTime?
  invitationAcceptedAt DateTime?

  // Sync Status
  lastSyncAt           DateTime?
  metadata             Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relationships
  disbursementTransactions DisbursementTransaction[]

  @@index([affiliateProfileId])
  @@index([riseId])
  @@index([kycStatus])
}

model PaymentBatch {
  id              String   @id @default(cuid())

  // Batch Identification
  batchNumber     String   @unique

  // Batch Summary
  paymentCount    Int      @default(0)
  totalAmount     Decimal  @default(0)
  currency        String   @default("USD")

  // Provider
  provider        DisbursementProvider

  // Status
  status          PaymentBatchStatus @default(PENDING)

  // Timestamps
  scheduledAt     DateTime?
  executedAt      DateTime?
  completedAt     DateTime?
  failedAt        DateTime?

  // Error Handling
  errorMessage    String?
  metadata        Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  transactions    DisbursementTransaction[]
  auditLogs       DisbursementAuditLog[]
  wiseBatchGroup  WiseBatchGroup?  // Part 19.5: Wise-side half of this batch

  @@index([status])
  @@index([scheduledAt])
  @@index([provider])
  @@index([batchNumber])
}

model DisbursementTransaction {
  id                String   @id @default(cuid())

  // Batch Reference
  batchId           String
  batch             PaymentBatch @relation(fields: [batchId], references: [id])

  // Commission Reference (from Part 17)
  commissionId      String   @unique
  commission        Commission @relation(fields: [commissionId], references: [id])

  // Transaction IDs
  transactionId     String   @unique
  providerTxId      String?

  // Provider
  provider          DisbursementProvider

  // Payee Info
  affiliateRiseAccountId String?
  affiliateRiseAccount   AffiliateRiseAccount? @relation(fields: [affiliateRiseAccountId], references: [id])
  payeeRiseId       String?

  // Amount
  amount            Decimal
  amountRiseUnits   BigInt?
  currency          String   @default("USD")

  // Status
  status            DisbursementTransactionStatus @default(PENDING)

  // Retry Logic
  retryCount        Int      @default(0)
  lastRetryAt       DateTime?

  // Error Handling
  errorMessage      String?
  metadata          Json?

  // Timestamps
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  failedAt          DateTime?

  // Relationships
  webhookEvents     RiseWorksWebhookEvent[]
  auditLogs         DisbursementAuditLog[]
  wiseTransfer      WiseTransfer?  // Part 19.5: Wise-side half of this transaction

  @@index([batchId])
  @@index([commissionId])
  @@index([status])
  @@index([providerTxId])
  @@index([createdAt])
}

model RiseWorksWebhookEvent {
  id              String   @id @default(cuid())

  // Transaction Reference
  transactionId   String?
  transaction     DisbursementTransaction? @relation(fields: [transactionId], references: [id])

  // Event Info
  eventType       String
  provider        DisbursementProvider

  // Payload
  payload         Json

  // Verification
  signature       String?
  hash            String?
  verified        Boolean  @default(false)

  // Processing Status
  processed       Boolean  @default(false)
  processedAt     DateTime?
  errorMessage    String?

  receivedAt      DateTime @default(now())

  @@index([transactionId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
}

model DisbursementAuditLog {
  id              String   @id @default(cuid())

  // References
  transactionId   String?
  transaction     DisbursementTransaction? @relation(fields: [transactionId], references: [id])
  batchId         String?
  batch           PaymentBatch? @relation(fields: [batchId], references: [id])

  // Action Info
  action          String
  actor           String?

  // Status
  status          AuditLogStatus

  // Details
  details         Json?
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())

  @@index([transactionId])
  @@index([batchId])
  @@index([action])
  @@index([createdAt])
}

// ── Part 19.5 · WISE DISBURSEMENT ─────────────────────────────────────────────

enum WiseRecipientStatus {
  DRAFT              // local record created, not yet sent to Wise
  PENDING_DETAILS    // affiliate must supply/repair bank details
  ACTIVE             // recipientId exists at Wise and is usable
  INVALID            // Wise rejected it, or a payout bounced on details
  ARCHIVED           // superseded by a newer recipient for the same affiliate
}

enum WiseBatchGroupStatus {
  NEW                        // Wise: open for transfers
  COMPLETED                  // Wise: closed, fundable, payInDetails available
  AWAITING_MANUAL_FUNDING    // LOCAL: COMPLETED + WISE_FUNDING_MODE=MANUAL, human owes an action
  FUNDED                     // LOCAL: funding observed (API call OK, or marked/detected)
  MARKED_FOR_CANCELLATION    // Wise
  PROCESSING_CANCEL          // Wise
  CANCELLED                  // Wise
}

enum WiseFundingSource {
  API_BALANCE        // POST …/batch-payments/{id}/payments
  MANUAL_ADMIN       // an admin asserted it, with evidence
  MANUAL_DETECTED    // inferred from a balances#credit / balances#update event
}

/// One Wise recipient (beneficiary) per affiliate. PII-minimising by design:
/// the authoritative bank details live at Wise, never here. See §7.4.
model AffiliateWiseRecipient {
  id                  String   @id @default(cuid())

  affiliateProfileId  String   @unique
  affiliateProfile    AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  wiseRecipientId     String?  @unique     // Wise numeric account id, stringified. Null while DRAFT.
  wiseProfileId       String                // which Wise profile owns it (audit; supports profile change)

  accountHolderName   String
  targetCurrency      String                // ISO-4217, e.g. "THB"
  recipientCountry    String                // ISO-3166-1 alpha-2
  legalType           String                // "PRIVATE" | "BUSINESS"
  requirementsType    String                // Wise requirement group, e.g. "thailand", "sort_code", "aba"

  accountTail         String?               // last 4 of the account number, for admin display ONLY
  detailsFingerprint  String?               // SHA-256 of the canonicalised submitted details — change detection, never reversible

  status              WiseRecipientStatus @default(DRAFT)
  lastValidatedAt     DateTime?
  invalidReason       String?
  metadata            Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transfers           WiseTransfer[]

  @@index([wiseRecipientId])
  @@index([status])
  @@index([targetCurrency])
}

/// The Wise-side half of a DisbursementTransaction. 1:1.
model WiseTransfer {
  id                        String   @id @default(cuid())

  disbursementTransactionId String   @unique
  disbursementTransaction   DisbursementTransaction @relation(fields: [disbursementTransactionId], references: [id])

  affiliateWiseRecipientId  String?
  affiliateWiseRecipient    AffiliateWiseRecipient? @relation(fields: [affiliateWiseRecipientId], references: [id])

  wiseBatchGroupId          String?               // local WiseBatchGroup.id; null for quick-pay
  wiseBatchGroup            WiseBatchGroup? @relation(fields: [wiseBatchGroupId], references: [id])

  // ── provider identifiers ──
  wiseTransferId            String   @unique      // Wise transfer id (numeric, stringified)
  wiseQuoteId               String                // Wise v2 quote UUID — one quote per transfer, never reused
  customerTransactionId     String   @unique      // OUR UUID v4 = Wise's idempotency key
  reference                 String?               // what the affiliate sees on their statement

  // ── money (audit-grade; keep all six) ──
  sourceCurrency            String
  sourceValue               Decimal
  targetCurrency            String
  targetValue               Decimal
  rate                      Decimal
  feeAmount                 Decimal  @default(0)
  feeBearer                 String                // "PLATFORM" | "AFFILIATE" (F38)

  // ── Wise lifecycle (String, not enum — Wise adds states; see §5.1) ──
  currentState              String   @default("created")
  previousState             String?
  lastEventOccurredAt       DateTime?             // data.occurred_at of the newest applied event — the ordering guard
  stateHistory              Json?                 // append-only [{state, occurredAt, deliveryId}]

  // ── payout failure detail (transfers#payout-failure) ──
  payoutFailureCode         String?
  payoutFailureDescription  String?
  hasActiveIssues           Boolean  @default(false)

  // ── at-most-once accounting guards (§5.3) ──
  balanceAppliedAt          DateTime?             // pending→paid applied exactly once
  balanceRevertedAt         DateTime?             // paid→pending reverted exactly once

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([wiseBatchGroupId])
  @@index([currentState])
  @@index([lastEventOccurredAt])
  @@index([payoutFailureCode])
}

/// The Wise-side half of a PaymentBatch. 1:1. Carries the funding gate.
model WiseBatchGroup {
  id                  String   @id @default(cuid())

  paymentBatchId      String   @unique
  paymentBatch        PaymentBatch @relation(fields: [paymentBatchId], references: [id])

  wiseBatchGroupId    String   @unique          // Wise batch-group UUID
  wiseProfileId       String
  wiseVersion         Int                        // Wise optimistic-concurrency version
  wiseName            String                     // ≤100 chars; we send PaymentBatch.batchNumber

  sourceCurrency      String
  transferCount       Int      @default(0)
  totalSourceAmount   Decimal  @default(0)

  status              WiseBatchGroupStatus @default(NEW)

  // ── funding gate ──
  payInDetails        Json?                      // verbatim Wise payInDetails[] once COMPLETED
  fundingSource       WiseFundingSource?
  fundedAt            DateTime?
  fundedByUserId      String?                    // who asserted/triggered it
  fundingEvidence     Json?                      // admin note, bank ref, balances#credit event id
  completedAt         DateTime?
  cancelledAt         DateTime?
  errorMessage        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transfers           WiseTransfer[]

  @@index([status])
  @@index([wiseBatchGroupId])
  @@index([createdAt])
}

/// Every inbound Wise webhook delivery. THE dedupe + replay table.
model WiseWebhookEvent {
  id                 String   @id @default(cuid())

  deliveryId         String   @unique      // X-Delivery-Id — the dedupe key (§5.4)
  subscriptionId     String?
  eventType          String                // transfers#state-change | transfers#payout-failure | …
  schemaVersion      String?               // "4.0.0" | "2.0.0"

  // ── denormalised for cheap lookup; nullable because not every event has them ──
  resourceType       String?               // "transfer"
  wiseResourceId     String?               // transfer id / profile id / balance id
  currentState       String?
  previousState      String?
  occurredAt         DateTime?             // data.occurred_at — the ORDERING key
  sentAt             DateTime?

  payload            Json                  // verbatim body
  rawSignature       String?               // X-Signature-SHA256 as received
  signatureVerified  Boolean  @default(false)
  isTestNotification Boolean  @default(false)

  processed          Boolean  @default(false)
  processedAt        DateTime?
  skippedReason      String?               // "stale-order" | "unknown-transfer" | "unhandled-type" | …
  errorMessage       String?
  attemptCount       Int      @default(0)

  receivedAt         DateTime @default(now())

  @@index([eventType])
  @@index([wiseResourceId])
  @@index([processed])
  @@index([occurredAt])
  @@index([receivedAt])
}

/// Wise webhook subscriptions we own, so cutover/rollback is auditable.
model WiseWebhookSubscription {
  id                String   @id @default(cuid())
  wiseSubscriptionId String  @unique
  scopeDomain       String                 // "application" | "profile"
  scopeId           String                 // clientKey or profileId
  eventType         String
  schemaVersion     String
  deliveryUrl       String
  environment       String                 // "sandbox" | "production"
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([eventType])
  @@index([active])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SYSTEM CONFIGURATION (Dynamic Settings)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// System-wide configuration settings that can be changed by admin
/// without code deployment. Used for affiliate discount/commission
/// percentages and other dynamic settings.
model SystemConfig {
  id          String   @id @default(cuid())

  /// Unique identifier for the setting (e.g., "affiliate_discount_percent")
  key         String   @unique

  /// Value stored as string (parsed based on valueType)
  value       String

  /// Type of value: "number", "string", "boolean", "json"
  valueType   String   @default("string")

  /// Human-readable description of what this setting controls
  description String?

  /// Category for grouping settings (e.g., "affiliate", "payment", "system")
  category    String

  /// User ID or email of admin who last updated this setting
  updatedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

/// History of all changes to SystemConfig for audit trail
model SystemConfigHistory {
  id         String   @id @default(cuid())

  /// The config key that was changed
  configKey  String

  /// Previous value before the change
  oldValue   String

  /// New value after the change
  newValue   String

  /// Email or ID of admin who made the change
  changedBy  String

  /// Optional reason for the change
  reason     String?

  changedAt  DateTime @default(now())

  @@index([configKey])
  @@index([changedBy])
  @@index([changedAt])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CHART DRAWINGS & LINE-TOUCH ALERTS (Drawing Engine — Phase 2/3)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// A user-drawn chart object. Geometry is stored as price/time anchors (never
// pixels) so the server can recompute level values headlessly (Phase 4).
model Drawing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol    String
  timeframe String
  type      String   // TRENDLINE | HLINE | CHANNEL | FIB_RETRACE | FIB_EXT | TEXT
  anchors   Json     // [{ time, price }, ...] (1-3 anchors)
  style     Json     // color, width, dash + tool-specific extras

  alerts    DrawingAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([symbol, timeframe])
  @@index([userId, symbol, timeframe])
}

// Links an Alert to a specific level of a Drawing (the watched price line).
model DrawingAlert {
  id          String   @id @default(cuid())
  drawingId   String
  drawing     Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  alertId     String   @unique
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  targetLevel String   // 'line' | 'channel_top' | 'fib_0.618' | 'fib_ext_1.618' ...
  direction   String   @default("either") // cross_up | cross_down | either
  tolerance   Float    @default(0)         // price units; 0 = pure cross
  cooldownSec Int      @default(60)
  oneShot     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([drawingId])
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// REFRESH TOKENS (Session 2-2 stub, hardened Session 3-2 per F23)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// F23 (DECISION-LOG.md, Session 3-2): hashed-at-rest + revocable. The raw
/// token is never stored — only its SHA-256 digest (`hashedToken`), looked
/// up by unique index; SHA-256 (not bcrypt) is correct here because the
/// value being hashed is already a high-entropy random secret (unlike a
/// user password), so O(1) unique-index lookup matters more than
/// per-guess slow-hashing. No @relation to User — plain userId, matching
/// the same-domain convention already used by UserSession/LoginHistory/
/// SecurityAlert (F4 census).
model RefreshToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

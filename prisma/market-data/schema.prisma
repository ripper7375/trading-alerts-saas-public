generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/market-client"
}

datasource db {
  provider = "postgresql"
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET DATA V6 (XAUUSD Railway Gateway pipeline)
//
// Decommissioned 2026-07-05: the old 63-column MarketData model (EA v2.27+:
// tema/hrma/smma, Keltner Channels, Heiken Ashi, sr_1-8, zigzag_high/low,
// pinbar, fractal diag/horiz lines) was removed here — see migration
// 20260705010000_drop_market_data. It was never read/written by any live
// app/api route (only by tests and this file's own seed helpers), and its
// EA v2.27 source has always lived under
// backend-stack-c/1_EA-and-backfill-worker-on-contabo-vps/architecture-document/old-architecture/,
// which now carries its own decommission note.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Downstream store for the backend-stack-c v6 XAUUSD pipeline (Push Worker ->
/// Railway Gateway -> here). Field names/types are a direct 1:1 mirror of
/// gateway_contract_market_data.schema.json (87 fields) — a different indicator
/// methodology (centroid-regression variants, EDT channels, ZigZag
/// categorization, cycle provenance) than the now-decommissioned MarketData
/// model this replaces (see the section comment above). Written by
/// railway-gateway's queue consumer (its own
/// prisma/schema.prisma mirrors this model for `prisma generate` only — this
/// schema, in the Next.js app, owns the actual migration for this table).
/// @@map to a lowercase, unquoted-safe table name since two independent
/// Prisma clients (this app + railway-gateway) write/read the same table.
model MarketDataV6 {
  id          String @id @default(cuid())
  terminal_id String
  timestamp   Int
  symbol      String
  timeframe   String
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Int

  // Centroid-regression variant: best_fit_a (config-identical to the former
  // single best_fit; 2026-09-03 isolated-coexistence split, see blueprint §3.4)
  best_fit_a_horiz_high_map Float?
  best_fit_a_horiz_low_map  Float?
  best_fit_a_ssa            Float?
  best_fit_a_ema_ssa        Float?
  best_fit_a_crossing       Int?
  best_fit_a_base_fl        Float?
  best_fit_a_uoedt          Float?
  best_fit_a_loedt          Float?

  // Centroid-regression variant: best_fit_b (new preset, no historical data
  // before 2026-09-03 — never certified, see CERTIFICATION.md)
  best_fit_b_horiz_high_map Float?
  best_fit_b_horiz_low_map  Float?
  best_fit_b_ssa            Float?
  best_fit_b_ema_ssa        Float?
  best_fit_b_crossing       Int?
  best_fit_b_base_fl        Float?
  best_fit_b_uoedt          Float?
  best_fit_b_loedt          Float?

  // Centroid-regression variant: cherry_a
  cherry_a_horiz_high_map Float?
  cherry_a_horiz_low_map  Float?
  cherry_a_ssa            Float?
  cherry_a_ema_ssa        Float?
  cherry_a_crossing       Int?
  cherry_a_base_fl        Float?
  cherry_a_uoedt          Float?
  cherry_a_loedt          Float?

  // Centroid-regression variant: cherry_b
  cherry_b_horiz_high_map Float?
  cherry_b_horiz_low_map  Float?
  cherry_b_ssa            Float?
  cherry_b_ema_ssa        Float?
  cherry_b_crossing       Int?
  cherry_b_base_fl        Float?
  cherry_b_uoedt          Float?
  cherry_b_loedt          Float?

  // Centroid-regression variant: most_recent
  most_recent_horiz_high_map Float?
  most_recent_horiz_low_map  Float?
  most_recent_ssa            Float?
  most_recent_ema_ssa        Float?
  most_recent_crossing       Int?
  most_recent_base_fl        Float?
  most_recent_uoedt          Float?
  most_recent_loedt          Float?

  // Centroid-regression variant: non_a
  non_a_horiz_high_map Float?
  non_a_horiz_low_map  Float?
  non_a_ssa            Float?
  non_a_ema_ssa        Float?
  non_a_crossing       Int?
  non_a_base_fl        Float?
  non_a_uoedt          Float?
  non_a_loedt          Float?

  // Centroid-regression variant: non_b
  non_b_horiz_high_map Float?
  non_b_horiz_low_map  Float?
  non_b_ssa            Float?
  non_b_ema_ssa        Float?
  non_b_crossing       Int?
  non_b_base_fl        Float?
  non_b_uoedt          Float?
  non_b_loedt          Float?

  // Fractal EDT + single best lines (calculated)
  fractal_best_fl Float?
  fractal_uoedt   Float?
  fractal_loedt   Float?
  best_resistance Float?
  best_support    Float?

  // Z-Score candle (calculated)
  body_direction      Int? // -1, 0, 1
  body_size           Float? // |z-score| (export convention)
  body_classification Int? // 0-5

  // ZigZag (pivot = admin layer; metrics + category calculated)
  zigzag_point_type          String? // "Peak" | "Bottom"
  zigzag_current_point       Float?
  zigzag_price_change        Float?
  zigzag_pct_change          Float?
  zigzag_pct_change_class    Int?
  zigzag_bars                Int?
  zigzag_bars_class          Int?
  zigzag_price_per_bar       Float?
  zigzag_price_per_bar_class Int?
  zigzag_slope               Float?
  zigzag_category            String? // HH | HL | LH | LL | EQH | EQL

  // Provenance
  cycle_id      Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  collected_at  Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  calculated_at Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_data_v6")
}

/// APPEND-ONLY. One row per (source, timeframe, collection cycle) — a snapshot of
/// what an indicator's fit looked like at that moment, parsed from the
/// _Statistic.txt companion the MQL5 indicators already write.
///
/// This is the deliberate opposite of MarketDataV6. That table is keyed by WHICH
/// BAR, so re-pushing a bar overwrites it — correct for live charting, but it
/// means a historical row holds the latest refit rather than what the indicator
/// actually said at the time. This table is keyed by WHEN IT WAS OBSERVED
/// (captured_at), so a new row never collides with an old one and history is
/// never rewritten. That is what makes it usable for drift detection and
/// walk-forward scoring.
///
/// The ONLY permitted write to an existing row is an idempotent re-push of
/// byte-identical content (push retries are by design). A correction is a NEW
/// row with a later captured_at — never an update.
///
/// Nothing here is derivable from market_data_v6: R2, MSE, variance ratio,
/// skewness, kurtosis, containment and window size exist nowhere else in the
/// pipeline. See STATISTIC-CAPTURE-SCOPE.md in the v2_29 pipeline folder.
model IndicatorStatistic {
  id String @id @default(cuid())

  // Identity + when observed
  terminal_id String
  symbol      String
  timeframe   String
  source      String // best_fit_a | best_fit_b | cherry_a | cherry_b | most_recent | non_a | non_b | fractal_edt | resistance | support
  captured_at Int // unix — the collector's 5-minute cycle slot; the append-only half of the key
  live_bar_ts Int // newest bar in that export; joins to MarketDataV6.timestamp
  cycle_id    Int

  // Resolved line. solution_found/line_origin_ts/touches come from the 3 line
  // indicators only; the centroids leave them null.
  solution_found   Boolean?
  raw_slope        Float?
  anchored_y_int   Float?
  regression_angle Float?
  line_origin_ts   Int?
  touches          Int?

  // Fitting window
  window_start_ts Int?
  window_end_ts   Int?
  window_bars     Int? // centroids: Observation Window (Box B Bars)
  math_lookback   Int? // centroids: Math Search Window (Bars)
  crossings_n     Int? // centroids: Total Crossings (n)

  // [MODEL A; CROSSINGS] — centroids only (the line indicators have no crossings)
  model_a_n         Int?
  model_a_r2        Float?
  model_a_mse       Float?
  model_a_var_ratio Float?
  model_a_skew      Float?
  model_a_kurt      Float?

  // [MODEL B; CLOSE PRICE] — all 10 sources. These lines are fitted to centroids
  // or fractal touches, NOT to closes, so a low or negative r2 is structurally
  // expected here and is not by itself a fault.
  model_b_n         Int?
  model_b_r2        Float?
  model_b_mse       Float?
  model_b_var_ratio Float?
  model_b_skew      Float?
  model_b_kurt      Float?

  // [EDT CHANNEL] — the 7 centroids + fractal_edt. resistance/support are single
  // lines with no channel, so they leave these null.
  uoedt_offset      Float?
  loedt_offset      Float?
  containment_n     Int?
  containment_count Int?
  containment_rate  Float? // percent of the fitted window that closed inside the channel

  // Which configuration produced this fit. Deduplicated because the parameters
  // are compiled into the .mq5 and change only on redeploy — storing them inline
  // would repeat an identical blob on every row. A NEW hash appearing is itself
  // the drift signal (the indicator was reconfigured).
  config_hash String
  config      IndicatorConfig @relation(fields: [config_hash], references: [config_hash])

  createdAt DateTime @default(now())

  // The append-only key. Postgres backs this with a btree index on exactly
  // these columns, so it also serves "this indicator, this timeframe, over
  // time" reads — no separate @@index on the same list.
  @@unique([symbol, timeframe, source, captured_at])
  @@index([source, captured_at])
  @@map("indicator_statistics")
}

/// The indicator input parameters behind an IndicatorStatistic, stored once per
/// distinct configuration rather than once per row.
///
/// The gateway processor MUST upsert this row BEFORE the statistic that
/// references it — IndicatorStatistic.config_hash is a real foreign key.
model IndicatorConfig {
  config_hash String @id // sha256 of the normalised parameter block
  source      String
  params      Json // the parameter block verbatim, as parsed key/value pairs
  first_seen  Int // unix — when this configuration was first observed

  createdAt  DateTime             @default(now())
  statistics IndicatorStatistic[]

  @@index([source])
  @@map("indicator_configs")
}

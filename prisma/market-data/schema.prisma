generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/market-client"
}

datasource db {
  provider = "postgresql"
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MARKET DATA V6 (XAUUSD Railway Gateway pipeline)
//
// Decommissioned 2026-07-05: the old 63-column MarketData model (EA v2.27+:
// tema/hrma/smma, Keltner Channels, Heiken Ashi, sr_1-8, zigzag_high/low,
// pinbar, fractal diag/horiz lines) was removed here — see migration
// 20260705010000_drop_market_data. It was never read/written by any live
// app/api route (only by tests and this file's own seed helpers), and its
// EA v2.27 source has always lived under
// backend-stack-c/1_EA-and-backfill-worker-on-contabo-vps/architecture-document/old-architecture/,
// which now carries its own decommission note.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Downstream store for the backend-stack-c v6 XAUUSD pipeline (Push Worker ->
/// Railway Gateway -> here). Field names/types are a direct 1:1 mirror of
/// gateway_contract_market_data.schema.json (103 fields) — a different indicator
/// methodology (centroid-regression variants, EDT channels, ZigZag
/// categorization, cycle provenance) than the now-decommissioned MarketData
/// model this replaces (see the section comment above). Written by
/// railway-gateway's queue consumer (its own
/// prisma/schema.prisma mirrors this model for `prisma generate` only — this
/// schema, in the Next.js app, owns the actual migration for this table).
/// @@map to a lowercase, unquoted-safe table name since two independent
/// Prisma clients (this app + railway-gateway) write/read the same table.
model MarketDataV6 {
  id          String @id @default(cuid())
  terminal_id String
  timestamp   Int
  symbol      String
  timeframe   String
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Int

  // Centroid-regression variant: best_fit_a (config-identical to the former
  // single best_fit; 2026-09-03 isolated-coexistence split, see blueprint §3.4)
  best_fit_a_horiz_high_map Float?
  best_fit_a_horiz_low_map  Float?
  best_fit_a_ssa            Float?
  best_fit_a_ema_ssa        Float?
  best_fit_a_crossing       Int?
  best_fit_a_base_fl        Float?
  best_fit_a_uoedt          Float?
  best_fit_a_loedt          Float?

  // Centroid-regression variant: best_fit_b (new preset, no historical data
  // before 2026-09-03 — never certified, see CERTIFICATION.md)
  best_fit_b_horiz_high_map Float?
  best_fit_b_horiz_low_map  Float?
  best_fit_b_ssa            Float?
  best_fit_b_ema_ssa        Float?
  best_fit_b_crossing       Int?
  best_fit_b_base_fl        Float?
  best_fit_b_uoedt          Float?
  best_fit_b_loedt          Float?

  // Centroid-regression variant: cherry_a
  cherry_a_horiz_high_map Float?
  cherry_a_horiz_low_map  Float?
  cherry_a_ssa            Float?
  cherry_a_ema_ssa        Float?
  cherry_a_crossing       Int?
  cherry_a_base_fl        Float?
  cherry_a_uoedt          Float?
  cherry_a_loedt          Float?

  // Centroid-regression variant: cherry_b
  cherry_b_horiz_high_map Float?
  cherry_b_horiz_low_map  Float?
  cherry_b_ssa            Float?
  cherry_b_ema_ssa        Float?
  cherry_b_crossing       Int?
  cherry_b_base_fl        Float?
  cherry_b_uoedt          Float?
  cherry_b_loedt          Float?

  // Centroid-regression variant: most_recent
  most_recent_horiz_high_map Float?
  most_recent_horiz_low_map  Float?
  most_recent_ssa            Float?
  most_recent_ema_ssa        Float?
  most_recent_crossing       Int?
  most_recent_base_fl        Float?
  most_recent_uoedt          Float?
  most_recent_loedt          Float?

  // Centroid-regression variant: non_a
  non_a_horiz_high_map Float?
  non_a_horiz_low_map  Float?
  non_a_ssa            Float?
  non_a_ema_ssa        Float?
  non_a_crossing       Int?
  non_a_base_fl        Float?
  non_a_uoedt          Float?
  non_a_loedt          Float?

  // Centroid-regression variant: non_b
  non_b_horiz_high_map Float?
  non_b_horiz_low_map  Float?
  non_b_ssa            Float?
  non_b_ema_ssa        Float?
  non_b_crossing       Int?
  non_b_base_fl        Float?
  non_b_uoedt          Float?
  non_b_loedt          Float?

  // Fractal EDT + single best lines (calculated)
  fractal_best_fl Float?
  fractal_uoedt   Float?
  fractal_loedt   Float?
  best_resistance Float?
  best_support    Float?

  // Support & Resistance auto-calibrated levels (calculated) — the 14th
  // indicator, SupportAndResistantAutoCalibration_v2_29 (2026-09-16).
  // Resolved per bar against that bar's own close: sr_1..sr_4 are the nearest
  // supports BELOW it (sr_1 closest), sr_5..sr_8 the nearest resistances ABOVE
  // it (sr_5 closest). NULL = that slot resolved no level; never 0.
  sr_1 Float?
  sr_2 Float?
  sr_3 Float?
  sr_4 Float?
  sr_5 Float?
  sr_6 Float?
  sr_7 Float?
  sr_8 Float?

  // The same levels from a second, independently anchored calibration window
  // — the 15th indicator, S-R-AutoCalibration_v2_29 (2026-09-22), a replica of
  // the 14th. sr_9..sr_12 are the nearest supports BELOW close (sr_9 closest),
  // sr_13..sr_16 the nearest resistances ABOVE it (sr_13 closest). NULL = that
  // slot resolved no level; never 0.
  sr_9  Float?
  sr_10 Float?
  sr_11 Float?
  sr_12 Float?
  sr_13 Float?
  sr_14 Float?
  sr_15 Float?
  sr_16 Float?

  // Z-Score candle (calculated)
  body_direction      Int? // -1, 0, 1
  body_size           Float? // |z-score| (export convention)
  body_classification Int? // 0-5

  // ZigZag (pivot = admin layer; metrics + category calculated)
  zigzag_point_type          String? // "Peak" | "Bottom"
  zigzag_current_point       Float?
  zigzag_price_change        Float?
  zigzag_pct_change          Float?
  zigzag_pct_change_class    Int?
  zigzag_bars                Int?
  zigzag_bars_class          Int?
  zigzag_price_per_bar       Float?
  zigzag_price_per_bar_class Int?
  zigzag_slope               Float?
  zigzag_category            String? // HH | HL | LH | LL | EQH | EQL

  // Provenance
  cycle_id      Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  collected_at  Int // always set by promote_cycle() for every promoted row; NOT NULL in sqlite_schema_v6_xauusd.sql
  calculated_at Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_data_v6")
}

/// APPEND-ONLY, NEVER UPDATED. One row per (symbol, timeframe, timestamp),
/// holding each indicator's reading AS IT STOOD when the bar had just closed.
///
/// `market_data_v6` cannot answer "what did the indicator say at that bar?".
/// Its rows are upserted on every collection cycle for as long as MT5 keeps
/// exporting the bar (~3000 bars: about 2.2 weeks on M5, 6.5 weeks on M15), so
/// a historical row holds what the indicator says about that bar TODAY, fitted
/// with price action that had not happened yet. That is correct and wanted for
/// live alerting and charts, and it is textbook look-ahead bias for anything
/// that reads stored history.
///
/// MEASURED, not assumed. Two real MT5 captures 12 days apart, diffed by
/// measure_indicator_drift.py over 2114 overlapping M15 bars: `*_uoedt` moved
/// on 100% of comparable bars by a mean of 19.26 USD, which is 14% of the
/// median EDT channel width; `*_ssa` moved on 100% of bars; `*_crossing`, a
/// boolean signal flag, FLIPPED on 0.71%. The controls behaved: OHLCV and
/// confirmed ZigZag pivots were unchanged.
///
/// WRITE-ONCE. The gateway inserts a row the first time it sees a bar whose
/// period has already ended, and never touches it again (INSERT ... ON CONFLICT
/// DO NOTHING). `market_data_v6` keeps updating in place, which is deliberate:
/// alerts and charts depend on the newest fit.
///
/// READ `snapshot_age_bars` BEFORE TRUSTING A ROW. It records how many whole
/// bar periods had elapsed between the bar closing and this snapshot being
/// taken. 1 is the honest value. Larger means the push worker was behind (see
/// PUSH-WORKER-THROUGHPUT-OPEN-ISSUE.md) and the row has that many bars of
/// hindsight in it. A backtest or fitness scorer MUST filter on it; the column
/// exists because a snapshot lane built on a backlogged push worker would
/// otherwise reproduce the very bias it is meant to remove, silently.
///
/// Columns are the 77 that actually drift. The OHLCV spine, the causal z-score
/// triple and the ZigZag metrics are deliberately absent -- they are stable, so
/// duplicating them would cost storage and buy nothing; join `market_data_v6`
/// on (symbol, timeframe, timestamp) for those.
///
/// Generated by backend-stack-c/.../generate_point_in_time_schema.py from the
/// collector's own SOURCES registry. Do not hand-edit; run the generator.
model MarketDataPointInTime {
  id        String @id @default(cuid())
  timestamp Int
  symbol    String
  timeframe String

  // Provenance of the snapshot itself.
  first_seen_at     Int // unix UTC; when this snapshot was taken
  snapshot_age_bars Int // whole bar periods between bar close and capture; 1 = honest
  cycle_id          Int? // the collector cycle the source row came from
  collected_at      Int? // when the collector promoted that row

  // best_fit_a
  best_fit_a_horiz_high_map  Float?
  best_fit_a_horiz_low_map   Float?
  best_fit_a_ssa             Float?
  best_fit_a_ema_ssa         Float?
  best_fit_a_crossing        Int?
  best_fit_a_base_fl         Float?
  best_fit_a_uoedt           Float?
  best_fit_a_loedt           Float?
  // best_fit_b
  best_fit_b_horiz_high_map  Float?
  best_fit_b_horiz_low_map   Float?
  best_fit_b_ssa             Float?
  best_fit_b_ema_ssa         Float?
  best_fit_b_crossing        Int?
  best_fit_b_base_fl         Float?
  best_fit_b_uoedt           Float?
  best_fit_b_loedt           Float?
  // cherry_a
  cherry_a_horiz_high_map    Float?
  cherry_a_horiz_low_map     Float?
  cherry_a_ssa               Float?
  cherry_a_ema_ssa           Float?
  cherry_a_crossing          Int?
  cherry_a_base_fl           Float?
  cherry_a_uoedt             Float?
  cherry_a_loedt             Float?
  // cherry_b
  cherry_b_horiz_high_map    Float?
  cherry_b_horiz_low_map     Float?
  cherry_b_ssa               Float?
  cherry_b_ema_ssa           Float?
  cherry_b_crossing          Int?
  cherry_b_base_fl           Float?
  cherry_b_uoedt             Float?
  cherry_b_loedt             Float?
  // most_recent
  most_recent_horiz_high_map Float?
  most_recent_horiz_low_map  Float?
  most_recent_ssa            Float?
  most_recent_ema_ssa        Float?
  most_recent_crossing       Int?
  most_recent_base_fl        Float?
  most_recent_uoedt          Float?
  most_recent_loedt          Float?
  // non_a
  non_a_horiz_high_map       Float?
  non_a_horiz_low_map        Float?
  non_a_ssa                  Float?
  non_a_ema_ssa              Float?
  non_a_crossing             Int?
  non_a_base_fl              Float?
  non_a_uoedt                Float?
  non_a_loedt                Float?
  // non_b
  non_b_horiz_high_map       Float?
  non_b_horiz_low_map        Float?
  non_b_ssa                  Float?
  non_b_ema_ssa              Float?
  non_b_crossing             Int?
  non_b_base_fl              Float?
  non_b_uoedt                Float?
  non_b_loedt                Float?
  // fractal_edt
  fractal_best_fl            Float?
  fractal_uoedt              Float?
  fractal_loedt              Float?
  // resistance
  best_resistance            Float?
  // support
  best_support               Float?
  // sr_levels
  sr_1                       Float?
  sr_2                       Float?
  sr_3                       Float?
  sr_4                       Float?
  sr_5                       Float?
  sr_6                       Float?
  sr_7                       Float?
  sr_8                       Float?
  // sr2_levels
  sr_9                       Float?
  sr_10                      Float?
  sr_11                      Float?
  sr_12                      Float?
  sr_13                      Float?
  sr_14                      Float?
  sr_15                      Float?
  sr_16                      Float?

  createdAt DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated, and a
  // column that implies otherwise would invite someone to start.
  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_data_point_in_time")
}

/// APPEND-ONLY. One row per (source, timeframe, collection cycle) — a snapshot of
/// what an indicator's fit looked like at that moment, parsed from the
/// _Statistic.txt companion the MQL5 indicators already write.
///
/// This is the deliberate opposite of MarketDataV6. That table is keyed by WHICH
/// BAR, so re-pushing a bar overwrites it — correct for live charting, but it
/// means a historical row holds the latest refit rather than what the indicator
/// actually said at the time. This table is keyed by WHEN IT WAS OBSERVED
/// (captured_at), so a new row never collides with an old one and history is
/// never rewritten. That is what makes it usable for drift detection and
/// walk-forward scoring.
///
/// The ONLY permitted write to an existing row is an idempotent re-push of
/// byte-identical content (push retries are by design). A correction is a NEW
/// row with a later captured_at — never an update.
///
/// Nothing here is derivable from market_data_v6: R2, MSE, variance ratio,
/// skewness, kurtosis, containment and window size exist nowhere else in the
/// pipeline. See STATISTIC-CAPTURE-SCOPE.md in the v2_29 pipeline folder.
model IndicatorStatistic {
  id String @id @default(cuid())

  // Identity + when observed
  terminal_id String
  symbol      String
  timeframe   String
  source      String // best_fit_a | best_fit_b | cherry_a | cherry_b | most_recent | non_a | non_b | fractal_edt | resistance | support | sr_levels | sr2_levels
  captured_at Int // unix — the collector's 5-minute cycle slot; the append-only half of the key
  live_bar_ts Int // newest bar in that export; joins to MarketDataV6.timestamp
  cycle_id    Int

  // Resolved line. solution_found/line_origin_ts/touches come from the 3 line
  // indicators only; the centroids leave them null.
  solution_found   Boolean?
  raw_slope        Float?
  anchored_y_int   Float?
  regression_angle Float?
  line_origin_ts   Int?
  touches          Int?

  // Fitting window
  window_start_ts Int?
  window_end_ts   Int?
  window_bars     Int? // centroids: Observation Window (Box B Bars)
  math_lookback   Int? // centroids: Math Search Window (Bars)
  crossings_n     Int? // centroids: Total Crossings (n)

  // [MODEL A; CROSSINGS] — centroids only (the line indicators have no crossings)
  model_a_n         Int?
  model_a_r2        Float?
  model_a_mse       Float?
  model_a_var_ratio Float?
  model_a_skew      Float?
  model_a_kurt      Float?

  // [MODEL B; CLOSE PRICE] — all 10 sources. These lines are fitted to centroids
  // or fractal touches, NOT to closes, so a low or negative r2 is structurally
  // expected here and is not by itself a fault.
  model_b_n         Int?
  model_b_r2        Float?
  model_b_mse       Float?
  model_b_var_ratio Float?
  model_b_skew      Float?
  model_b_kurt      Float?

  // [EDT CHANNEL] — the 7 centroids + fractal_edt. resistance/support are single
  // lines with no channel, so they leave these null.
  uoedt_offset      Float?
  loedt_offset      Float?
  containment_n     Int?
  containment_count Int?
  containment_rate  Float? // percent of the fitted window that closed inside the channel


  // Extended statistics [added 2026-09-20]. Every indicator writes the
  // same section set, so these are populated across all 10 sources rather
  // than a subset. Null means the field does not apply to that source, or
  // the terminal still runs a binary that predates the block -- never
  // zero, because 0.0 is a real reading for most of them.
  window_span_bars        Int?    // bars from the leftmost evaluated bar to the live bar, inclusive
  visual_window_bars      Int?    // bars the channel is DRAWN over (can exceed the evaluated window)
  bars_available          Int?    // bars the indicator actually had; distinguishes a short fit from a short chart
  leftmost_bar_index      Int?    // index of the oldest evaluated bar, for reproducing the fit
  line_span_bars          Int?    // bars between the oldest and newest resolved baseline value
  baseline_coverage_n     Int?    // bars in that span carrying a resolved baseline
  baseline_coverage_rate  Float?  // percent; 100 * baseline_coverage_n / line_span_bars, gaps show up as < 100
  centroids_used          Int?    // centroids the winning fit actually used; null for non-centroid sources
  crossings_in_window_n   Int?    // SSA crossings inside the drawn span (crossings_n counts the evaluated window)
  first_crossing_ts       Int?    // unix UTC of the oldest crossing in that span
  last_crossing_ts        Int?    // unix UTC of the newest; with first_crossing_ts this dates the evidence the fit rests on
  live_close              Float?  // close of the newest bar, so the snapshot is self-contained
  baseline_value          Float?  // fitted baseline AT the live bar (not the y-intercept)
  uoedt_value             Float?  // upper band price at the live bar
  loedt_value             Float?  // lower band price at the live bar
  dist_to_baseline        Float?  // live_close - baseline_value; signed
  dist_to_uoedt           Float?  // uoedt_value - live_close; negative means price is above the band
  dist_to_loedt           Float?  // live_close - loedt_value; negative means price is below the band
  channel_position        Float?  // 0 at LOEDT, 1 at UOEDT; outside [0,1] means price has left the channel
  window_high             Float?  // highest high across the resolved span
  window_low              Float?  // lowest low across the resolved span
  window_range            Float?  // window_high - window_low; the scale channel_width should be read against
  channel_width           Float?  // uoedt_value - loedt_value in price units
  channel_asymmetry       Float?  // (uoedt_offset + loedt_offset) / width; 0 = symmetric. Reported, never penalised: EDT bands come from outermost touches, so asymmetry is often a true reading
  breach_above_n          Int?    // closes above the upper band; containment_rate alone cannot say which side price left from
  breach_below_n          Int?    // closes below the lower band
  max_excursion_above     Float?  // worst close-above-band distance; null when there was none
  max_excursion_below     Float?  // worst close-below-band distance; null when there was none
  resid_a_n               Int?    // sample for the crossings residual diagnostics; measured over the DRAWN span, which need not equal model_a_n
  resid_a_mean            Float?  // bias: a line parallel to price but offset from it still scores well on MSE
  resid_a_mae             Float?  // outlier-insensitive counterpart to MSE
  resid_a_sd              Float?  // dispersion around that bias, in price units
  resid_a_max             Float?  // worst single miss
  resid_a_dw              Float?  // serial correlation; ~2 independent, <1 means a straight line is the wrong MODEL here, not merely a badly fitted one
  resid_b_n               Int?    // sample for the close-price residual diagnostics
  resid_b_mean            Float?  // bias against close prices
  resid_b_mae             Float?  // outlier-insensitive counterpart to model_b_mse
  resid_b_sd              Float?  // dispersion around that bias
  resid_b_max             Float?  // worst single miss
  resid_b_dw              Float?  // the diagnostic model_b_r2 cannot give: these lines are fitted to centroids or touches and then scored against closes, so r2 is routinely negative


  // [SUPPORT-RESISTANCE AUTO-CALIBRATION] provenance [added 2026-09-20].
  // Populated by sources 'sr_levels' and 'sr2_levels' only; null everywhere
  // else. sr_1..sr_16 are NOT duplicated here -- they already reach Postgres
  // through MarketDataV6. What these record is WHY those levels exist: which
  // fractal sample, what dispersion, what bucket width.
  sr_fractals_n           Int?    // fractals the Freedman-Diaconis calibration was computed from; a small N means a wide, unreliable step
  sr_q25                  Float?  // 25th percentile of that fractal sample
  sr_q75                  Float?  // 75th percentile
  sr_iqr                  Float?  // interquartile range; the dispersion the bucket width is derived from
  sr_optimal_step         Float?  // auto-calibrated bucket width. THE field: every sr_* level in market_data (sr_1..sr_8 for sr_levels, sr_9..sr_16 for sr2_levels) is a bucket of this size, and nothing downstream could previously tell how wide they were
  sr_macro_clusters       Int?    // clusters found before the 8-slot pipeline truncation; > 8 means levels were dropped
  sr_nearest_resistance   Float?  // closest level above the live close
  sr_nearest_support      Float?  // closest level below
  sr_dist_resistance_pts  Int?    // distance to it in POINTS, not price -- the indicator's own unit, kept as exported
  sr_dist_support_pts     Int?    // distance to it in POINTS

  // Which configuration produced this fit. Deduplicated because the parameters
  // are compiled into the .mq5 and change only on redeploy — storing them inline
  // would repeat an identical blob on every row. A NEW hash appearing is itself
  // the drift signal (the indicator was reconfigured).
  config_hash String
  config      IndicatorConfig @relation(fields: [config_hash], references: [config_hash])

  createdAt DateTime @default(now())

  // The append-only key. Postgres backs this with a btree index on exactly
  // these columns, so it also serves "this indicator, this timeframe, over
  // time" reads — no separate @@index on the same list.
  @@unique([symbol, timeframe, source, captured_at])
  @@index([source, captured_at])
  @@map("indicator_statistics")
}

/// The indicator input parameters behind an IndicatorStatistic, stored once per
/// distinct configuration rather than once per row.
///
/// The gateway processor MUST upsert this row BEFORE the statistic that
/// references it — IndicatorStatistic.config_hash is a real foreign key.
model IndicatorConfig {
  config_hash String @id // sha256 of the normalised parameter block
  source      String
  params      Json // the parameter block verbatim, as parsed key/value pairs
  first_seen  Int // unix — when this configuration was first observed

  createdAt  DateTime             @default(now())
  statistics IndicatorStatistic[]

  @@index([source])
  @@map("indicator_configs")
}

/// One observation of one economic-calendar release, read from MT5's built-in
/// Economic Calendar on the same terminal that runs the 13 export indicators.
///
/// APPEND-ONLY, enforced by the KEY rather than a trigger: a revised forecast
/// or a newly published actual is a NEW row with a later captured_at, never an
/// update. Overwriting would destroy what the market knew BEFORE the release —
/// the same loss HISTORICAL-VALUES-LOOK-AHEAD-BIAS-OPEN-ISSUE.md records as
/// unrecoverable for market_data. Current state is
/// `DISTINCT ON (value_id) ... ORDER BY value_id, captured_at DESC`; the
/// reverse, recovering history from an overwritten row, is impossible.
///
/// NOT symbol-scoped. Economic events are global; relevance to XAUUSD is
/// derived from `currency` at query time rather than denormalised here.
model EconomicEvent {
  id String @id @default(cuid())

  terminal_id String

  // Ids are String, not Int or BigInt. Upstream they are MQL5 `ulong` (64-bit)
  // and JSON has no 64-bit integer, so a large id would silently lose precision
  // crossing the gateway. They are opaque — never used for arithmetic, and
  // ordering is always by captured_at / event_time.
  value_id    String // MqlCalendarValue.id — one specific release
  captured_at Int // unix UTC — when observed; the append-only half of the key
  event_id    String // MqlCalendarEvent.id — the recurring event

  event_time   Int // unix UTC — when the event occurs (converted from server time at source)
  event_period Int? // unix UTC — the reporting period covered, not the publication moment
  revision     Int?

  country_code String // ISO 3166-1 alpha-2
  currency     String // ISO 4217 — the XAUUSD relevance filter

  event_name String
  importance String // NONE | LOW | MODERATE | HIGH

  // Raw upstream enums, stored unmapped. time_mode matters to consumers: a
  // non-exact mode means event_time is a day or a floating estimate, so a
  // countdown must not imply second precision for those.
  event_type Int?
  sector     Int?
  frequency  Int?
  time_mode  Int?
  unit       Int?
  multiplier Int?
  digits     Int?
  event_code String?
  source_url String?

  // Values, already divided by 10^6 at source.
  //
  // NULL means NOT PUBLISHED, never zero — a genuine 0.0 reading is real data.
  // For forecast_value NULL is the COMMON case: Step Zero measured only 12 of
  // 23 upcoming HIGH-impact events carrying one, because rate decisions, votes
  // and speeches structurally have no numeric forecast. Consumers must render
  // "no forecast published" rather than substitute a number.
  actual_value       Float?
  forecast_value     Float?
  prev_value         Float?
  revised_prev_value Float?
  impact_type        Int? // ENUM_CALENDAR_EVENT_IMPACT — upstream's opinion, not ours

  createdAt DateTime @default(now())

  // The append-only key. Postgres backs a unique constraint with a btree index
  // on exactly these columns, so no separate @@index repeats this list.
  @@unique([value_id, captured_at])
  // "What is the next HIGH-impact event?" — the countdown's only query.
  @@index([event_time, importance])
  // "What is coming for USD?" — the Stack D news pillar's filter.
  @@index([currency, event_time])
  @@map("economic_events")
}

/// Lane 4: G8 Currency & Gold Index Suite — the public landing-page widget's
/// data source (8 equal-weighted currency indices + rebased gold index XAUX).
///
/// One row per (index_name, bar_time) — NOT a revision stream like
/// IndicatorStatistic/EconomicEvent above. Each bar's value is a
/// deterministic, stateless recomputation from that bar's own rates (see
/// currency_gold_index_engine.py's index_value() docstring), so a given key
/// has exactly one correct value and the gateway upserts in place; a retry
/// delivering the same key is a true no-op, not an append.
///
/// Written by currency_gold_index_engine.py, a FULLY SEPARATE process from
/// the v6 alert pipeline — own script, own NSSM service, own SQLite outbox
/// (never xauusd.db), own input files. A failure in this lane can never
/// affect market_data_v6, IndicatorStatistic or EconomicEvent in any way.
model CurrencyGoldIndex {
  id String @id @default(cuid())

  terminal_id String
  index_name  String // XAUX | USDX | EURX | JPYX | GBPX | AUDX | NZDX | CADX | CHFX
  bar_time    Int // unix UTC — the M5 bar this value was computed for

  value      Float // rebased to exactly 100.00 at session_open_bar_time by construction
  change_pct Float // == value - 100.00 always (closed-form; stored for API convenience)

  // unix UTC — today's session-inception bar for THIS index (00:00 Eightcap
  // server time for the 8 currency indices, 01:01 for XAUX's own daily
  // rollover reopen). Stamped by the engine, which alone has ground truth of
  // the documented Eightcap UTC-offset rule, so no downstream reader ever has
  // to re-derive today's session boundary via its own DST-offset logic.
  session_open_bar_time Int

  // Index OPEN/HIGH/LOW of the same M5 bar (`value` is the index CLOSE), on the
  // same session-inception base. High/Low follow the authoritative
  // *_H1_High.mq5 / *_H1_Low.mq5 rule: each input symbol contributes its bar
  // High where the index carries it with a positive net exponent, its Low where
  // negative (mirror image for Low). NULL for a row pushed by an engine build
  // that predates index OHLC -- never defaulted to `value`, so a reader can tell
  // "no OHLC" from a genuinely flat bar. Added for the Currency Index Comparison
  // PRO page's OHLC / Heiken Ashi candles.
  open Float?
  high Float?
  low  Float?

  createdAt DateTime @default(now())

  // One row per (index_name, bar_time). Postgres backs this with a btree
  // index Postgres also uses for the "this index over time" sparkline read —
  // no separate non-unique index on the same list.
  @@unique([index_name, bar_time])
  @@index([index_name, bar_time(sort: Desc)])
  @@map("currency_gold_indices")
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CURRENCY INDEX PRO PLAN (Lane 4 extension) — Phase 1
//
// Design: davintrade-currency-index-pro-plan/
// COMPREHENSIVE_ARCHITECTURE_DESIGN_CURRENCY_INDEX_PRO_PLAN.md
//
// These 3 models are pure market/signal data derived from
// CurrencyGoldIndex's own rows — no user reference anywhere, so (unlike
// UserCurrencyIndexPreference, which lives in prisma/non-market-data/
// schema.prisma alongside User) they belong in this file. Populated by a
// new railway-gateway worker-side cron
// (currency-index-corridor-aggregator.service.ts), not by the VPS engine —
// no MQL5/Python change is needed for this phase.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// Pre-aggregated daily peak-excursion metrics per FX currency index (the 8
/// G8 currencies only — never XAUX, which has its own unrelated 01:01
/// rollover and isn't part of the PRO screener). One row per calendar day
/// per index, finalized once that day's session has closed (i.e. once the
/// NEXT day's session_open_bar_time appears in CurrencyGoldIndex), so
/// `close_pct` is a genuine closing value, never a still-forming one.
/// Exists so the 5-60 day lookback corridor calculation
/// (DailyVolatilityCorridor) never has to rescan raw intraday bars.
model DailyCurrencyIndexMetrics {
  id String @id @default(cuid())

  // unix UTC — deliberately Int, not DateTime, matching every other
  // business timestamp in this schema (bar_time, event_time, captured_at):
  // stores the exact session_open_bar_time of the day being summarized, so
  // "which day" is the same natural key the rest of the stack already uses
  // rather than a separately-derived calendar date.
  date       Int
  index_name String // USDX | EURX | GBPX | JPYX | AUDX | CADX | CHFX | NZDX

  open_value    Float // the actual value read at that day's session_open_bar_time (expected ~100.00 by construction, but read rather than assumed)
  peak_high_pct Float // max(change_pct) across the day's bars
  peak_low_pct  Float // abs(min(change_pct)) across the day's bars
  close_pct     Float // change_pct of the last bar before the next day's rollover

  created_at DateTime @default(now())

  @@unique([date, index_name])
  @@index([date])
  @@map("daily_currency_index_metrics")
}

/// The daily system-calculated Dynamic Volatility Corridor (spec §3.2's
/// mu_basket/sigma_basket), computed once per day from the trailing
/// min(lookback_days, available) DailyCurrencyIndexMetrics rows. One row
/// per calendar day — this is the shared, system-wide default; a PRO user's
/// own slider override (UserCurrencyIndexPreference) is applied client-side
/// and never rewrites this table.
model DailyVolatilityCorridor {
  id String @id @default(cuid())

  date             Int   @unique // unix UTC — same session_open_bar_time convention as DailyCurrencyIndexMetrics.date above
  lookback_days    Int   @default(20) // how many prior days actually went into this calculation (may be < the requested default if Lane 4 data is still young)
  strike_zone_pct  Float // Tier 1: +/- mu_basket
  extreme_zone_pct Float // Tier 2: +/- (mu_basket + sigma_basket)
  mean_excursion   Float // raw mu_basket
  std_dev          Float // raw sigma_basket

  calculated_at DateTime @default(now())

  @@map("daily_volatility_corridors")
}

/// Audit log of generated Stage A (corridor-entry) / Stage B (HRMA x SMMA
/// confirmed cross) signals. Declared in this phase; populated starting
/// Phase 2, once the NestJS gateway's confluence-scoring engine exists —
/// no writer exists yet.
model CurrencyIndexSignal {
  id String @id @default(cuid())

  timeframe   String @default("M15") // signals are M15-only per the spec's noise-reduction rule
  bar_time    Int // unix UTC — the closed M15 bar this signal fired on
  index_name  String // USDX | EURX | GBPX | JPYX | AUDX | CADX | CHFX | NZDX
  index_value Float
  hrma_val    Float
  smma_val    Float
  zone_state  String // OVERBOUGHT | OVERSOLD | NEUTRAL
  signal_type String // CONFIRMED_BUY | CONFIRMED_SELL | NONE
  top_pairs   Json // e.g. [{"pair": "GBPJPY", "action": "BUY", "rank": 1}]

  created_at DateTime @default(now())

  @@index([bar_time, index_name])
  @@map("currency_index_signals")
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STACK D CHAPTER 1: CYCLES, ACTIVE INDICATOR, SYMBOL SPECS, CYCLE EVENTS
// (build step 2, part 2; docs/STACK-D-ARCHITECTURE.md section 1)
//
// Four additive tables, written by railway-gateway (its own
// prisma/schema.prisma mirrors them for `prisma generate` only; this schema
// owns the migration, 20261002000000_add_cycle_pipeline_tables). Every business
// timestamp is Int unix UTC, like the rest of this file. The rule for each
// slot-valued column: a multiple of 300 (rule 1, ADR-008).
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// One row per 5-minute slot (rule 1, ADR-008): the cycle stamp the rest of
/// Stack D reads. The push worker sends a manifest after the cycle's newest
/// bars; the gateway checks it against what landed, writes this row and queues
/// the Section 2 job keyed by the slot (ADR-009).
///
/// The row is written PENDING when the manifest arrives and moves to READY or
/// INCOMPLETE once, so unlike the append-only tables it has an `updatedAt`.
/// Only FRESH and DELAYED are ever stored in `data_status`: STALE and
/// MARKET_CLOSED describe the absence of a cycle and are computed at read time
/// (src/cycle/data-status.ts), never written.
///
/// `attempts` is an input of that computation, not a statistic: a cycle the
/// collector had to retry gets a 4-minute ready deadline instead of 2 (ADR-012).
model MarketCycle {
  id String @id @default(cuid())

  symbol String
  slot   Int // unix UTC, a multiple of 300: the cycle key

  state       String // PENDING | READY | INCOMPLETE
  data_status String? // FRESH | DELAYED once READY; NULL before. Never STALE or MARKET_CLOSED
  attempts    Int // collector attempts the cycle needed (the larger of M5 and M15); 1 is first try

  // Timings. Gateway clock unless stated. ready_at - slot is the slot-to-ready
  // time that section 1.8 asks to be measured; it is derived, not stored.
  manifest_received_at   Int
  ready_at               Int? // NULL until READY
  collector_started_at   Int? // VPS clock: the first collection attempt of this slot (the M5 cycle's)
  collector_validated_at Int? // VPS clock: the cycle passed validation and was promoted (the M5 cycle's)

  // What the manifest declared, per timeframe. NULL on a slot that does not
  // refresh that timeframe (M15 is collected only at :00 :15 :30 :45).
  m5_collection_cycle_id  Int? // collector cycle_id, kept as provenance (ADR-008)
  m15_collection_cycle_id Int?
  m5_bar_count            Int?
  m15_bar_count           Int?
  // Open time of the newest row in the push. It may be the bar that is about to
  // close rather than a stub of the new one: the first real cycles settle this
  // (waiting-on.md, 2026-10-02), so it is recorded as found, not interpreted.
  m5_newest_bar_ts        Int?
  m15_newest_bar_ts       Int?
  // When the MT5 export the cycle was collected from was written, as unix UTC.
  // Take it from the file's modification time: the "Export Time" line inside an
  // export is TimeCurrent(), the last tick's broker server time, which is not
  // UTC and lags the write on a quiet market.
  m5_export_at            Int?
  m15_export_at           Int?
  check_detail            Json? // expected versus landed counts and newest times when the check fails

  // Which terminal and tuning produced the cycle (ADR-015). A change from the
  // previous cycle is how a promote is noticed. terminal_id is the manifest's
  // mt5_terminal (the MT5 terminal's folder, e.g. MT5-A), not the sender id.
  // Keyed by timeframe first because the same source can be configured
  // differently on the M5 and the M15 chart.
  terminal_id   String?
  config_hashes Json? // { "<timeframe>": { "<source>": "<config_hash>" } }
  source_modes  Json? // { "<timeframe>": { "<source>": "DYNAMIC" | "FROZEN" } }, centroid sources only

  // RETUNING: true from the promote's effective slot until the re-pushed window
  // is complete, meaning the gateway counts no M5 row of the 3,000-bar window left
  // from before the promote (cycle_id below the promote cycle's), and the manifest
  // that counts it is verified (ADR-015, settled 2026-10-01; completion rule
  // Option A, 2026-10-02).
  retuning           Boolean @default(false)
  backlog_rows       Int? // outbox rows unsent when the manifest was sent
  repush_rows_unsent Int? // of those, rows queued by a promote's re-push; a diagnostic, the gateway does not read it

  // SHA-256 of the closed-bar OHLC spine the cycle was declared ready on
  // (replay scope, decided 2026-10-01). Indicator columns on closed bars are
  // refit by later cycles and are deliberately not in it.
  closed_bars_digest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One cycle per slot per symbol. A re-delivered manifest hits this key and
  // must neither create a second row nor queue a second job.
  @@unique([symbol, slot])
  @@map("market_cycles")
}

/// The active channel indicator per timeframe (rule 6, ADR-010). APPEND-ONLY:
/// a change is a NEW row, never an update or a delete, so the setting that held
/// at any past slot can always be read back and a replay of that slot cannot
/// change.
///
/// Resolution for (timeframe, slot): the row with the greatest `effective_slot`
/// at or before the slot; among rows with the same `effective_slot` the latest
/// `createdAt`, then the greatest `id`, wins (that is how a not-yet-effective
/// entry is superseded). MCDs, the renderer and the UI all resolve through the
/// one function so they switch on the same slot.
///
/// Enforced by the setter, not by this table: `effective_slot` must be later
/// than the current slot, because a row added for a slot that has already passed
/// would rewrite history. The migration seeds the ADR-010 starting values with
/// `effective_slot` 0, so every slot resolves to something.
model ActiveIndicatorSetting {
  id String @id @default(cuid())

  timeframe      String // M5 | M15
  source         String // a channel indicator: best_fit_a | best_fit_b | cherry_a | cherry_b | most_recent | non_a | non_b | fractal_edt (validated by the setter)
  effective_slot Int // unix UTC, a multiple of 300: applies to every slot at or after it
  set_by         String // admin email or id; 'migration' for the starting values. A plain string, not a foreign key, so this table stays in the market-data schema
  reason         String?

  createdAt DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated.
  @@index([timeframe, effective_slot])
  @@map("active_indicator_settings")
}

/// Broker figures for XAUUSD (ADR-066, section 6.9), read from the MT5 terminal
/// that runs the export indicators, daily and whenever a value changes.
/// APPEND-ONLY: Engine 4 records the `version` of the row it sized a lot with in
/// the consent record, so that row has to stay as it was.
///
/// Two keys, two jobs. (symbol, captured_at) makes a re-delivered capture a
/// no-op. (symbol, version) is a per-symbol counter assigned by the gateway on
/// first insert. `commission` is not here: MT5 does not expose it and it is the
/// trader's own input.
model SymbolSpec {
  id String @id @default(cuid())

  terminal_id String
  symbol      String
  version     Int // per symbol, 1 upward, assigned by the gateway
  captured_at Int // unix UTC, when the terminal was read

  contract_size  Float // SYMBOL_TRADE_CONTRACT_SIZE
  volume_min     Float // SYMBOL_VOLUME_MIN
  volume_step    Float // SYMBOL_VOLUME_STEP
  volume_max     Float // SYMBOL_VOLUME_MAX
  tick_size      Float // SYMBOL_TRADE_TICK_SIZE
  typical_spread Float // median SYMBOL_SPREAD, in points
  swap_long      Float // SYMBOL_SWAP_LONG
  swap_short     Float // SYMBOL_SWAP_SHORT

  // Beyond the section 6.9 table: the units needed to read the figures above.
  // A spread in points is not a price without SYMBOL_POINT, and a swap figure
  // means points, currency or percent depending on SYMBOL_SWAP_MODE.
  point     Float // SYMBOL_POINT: price per point
  digits    Int // SYMBOL_DIGITS
  swap_mode Int // SYMBOL_SWAP_MODE, the raw enum value

  createdAt DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated.
  @@unique([symbol, captured_at])
  @@unique([symbol, version])
  @@map("symbol_specs")
}

/// Things that happen to the pipeline and that later sections read as events
/// rather than as cycles. APPEND-ONLY. Build step 2 writes one type: PROMOTE
/// (ADR-015): the collector switched to another terminal or tuning, recorded
/// with its effective slot, the terminal, the `config_hash` per source and the
/// mode. RETUNE_COMPLETE and WATCHDOG_ALERT are expected later; the type is a
/// string for that reason.
///
/// `dedupe_key` is chosen by the producer so that noticing the same thing twice
/// writes it once, for example `PROMOTE:XAUUSD:<slot>:<terminal>`.
model CycleEvent {
  id String @id @default(cuid())

  symbol         String
  event_type     String // PROMOTE (step 2); RETUNE_COMPLETE | WATCHDOG_ALERT later
  effective_slot Int // unix UTC, a multiple of 300: the slot the event takes effect
  dedupe_key     String @unique

  terminal_id   String?
  config_hashes Json? // { "<timeframe>": { "<source>": "<config_hash>" } }
  source_modes  Json? // { "<timeframe>": { "<source>": "DYNAMIC" | "FROZEN" } }
  detail        Json? // anything specific to the event type

  createdAt DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated.
  @@index([symbol, event_type, effective_slot])
  @@map("cycle_events")
}

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STACK D CHAPTER 2: SENSOR READINGS, CYCLE INPUTS, STATE STATISTICS
// (build step 3, part 2; docs/STACK-D-ARCHITECTURE.md section 2)
//
// Three additive tables, written by railway-gateway's sensor worker (its own
// prisma/schema.prisma mirrors them for `prisma generate` only; this schema
// owns the migration, 20261003000000_add_sensor_tables). Business timestamps are
// Int unix UTC, like the rest of this file, and a cycle slot is a multiple of 300
// (rule 1, ADR-008). No foreign keys, as in chapter 1: a bundle ages out after 90
// days while the readings made from it stay.
//
// Two rules are CHECK constraints in the migration, which Prisma cannot express
// and its diff does not see: state_statistics holds no number below n = 30
// (ADR-022), and mcd_outputs never holds a row whose flag is off.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/// One MCD's reading of one cycle (architecture 2.2 point 5): what the sensor
/// worker saved for a symbol, a slot and an MCD, INVALID and STALE readings
/// included. APPEND-ONLY: a row is never updated, and a cycle delivered twice
/// writes nothing new (the unique key). It holds the readings of MCDs whose flag
/// is `shadow` or `live`, never `off` (a CHECK in the migration); certification
/// replay gets its own table later (ADR-020: two histories).
///
/// `envelope_json` is the canonical text of the envelope (mcd-output/1) exactly as
/// the runner produced it: the record, and what `envelope_sha256` hashes.
/// `envelope` is the same document as JSONB, for queries only. `status`,
/// `state_code` and `bias` repeat envelope fields so a reader can filter without
/// opening it.
///
/// Timings and the Python version describe the run, not the reading, so they live
/// in columns and never inside the envelope: two runs of one bundle must give the
/// same envelope byte for byte.
///
/// `evaluator_envelope_sha256` hashes the evaluator's own reading, before the
/// worker marked it CAUTIONARY for an MCD0 defect (ADR-018). It equals
/// `envelope_sha256` when the worker added nothing, that is when
/// `inherited_reasons` is empty.
model McdOutput {
  id String @id @default(cuid())

  symbol     String
  cycle_slot Int // unix UTC, a multiple of 300: the cycle (rule 1). The envelope carries the same slot as ISO 8601 text
  mcd_id     String // MCD0 to MCD15

  flag              String // shadow | live: the MCD's flag when the row was written. Never off (CHECK in the migration)
  evaluator_version String // MAJOR.MINOR.PATCH of the evaluator that read the cycle

  status     String // VALID | CAUTIONARY | INVALID | STALE
  state_code String? // NULL when status is INVALID or STALE: the envelope schema requires it
  bias       String? // LONG | SHORT | NEUTRAL | STAND_ASIDE; NULL when status is INVALID or STALE

  envelope_json String // the canonical envelope text, byte for byte
  envelope      Json // the same document as JSONB

  envelope_sha256           String // SHA-256 (hex) of envelope_json
  evaluator_envelope_sha256 String // SHA-256 (hex) of the evaluator's reading before inheritance
  inputs_sha256             String? // SHA-256 (hex) of the cycle's canonical bundle text; NULL only if the bundle could not be written as JSON

  inherited_reasons String[] @default([]) // MCD0_DEFECT_<TF> codes the worker added to status_reasons, in order
  guard_problems    String[] @default([]) // why the evaluator's reading was replaced by an INVALID one; empty when it was kept

  // RETUNING (ADR-015). Observed: the READY market_cycles row said so. Applied:
  // the worker told the sensors (SENSOR_RETUNING_ENFORCED), so the envelope shows
  // it. Replay sends the stored bundle with enforcement equal to `applied`.
  retuning_observed Boolean
  retuning_applied  Boolean

  runner_version String // mcd_worker's RUNNER_VERSION
  python_version String // for example 3.11.9
  duration_ms    Float // wall time of this MCD, milliseconds
  evaluated_at   Int // unix UTC, the gateway's clock when the cycle was evaluated

  created_at DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated.
  @@unique([symbol, cycle_slot, mcd_id])
  @@map("mcd_outputs")
}

/// The exact inputs of one cycle's sensor run, frozen (build step 3, decision Q4;
/// architecture 2.2 point 6). The channel columns the sensors read are refit by
/// later cycles (ADR-020), so a cycle cannot be rebuilt from `market_data_v6` a
/// week later; this row is what a replay of "a stored cycle" reads.
///
/// Written once, in the same transaction as the cycle's `mcd_outputs` rows. The
/// first bundle of a slot is the one the readings were made from, so a cycle
/// delivered twice never replaces it (the unique key). The only deletion is
/// retention, 90 days from the cycle slot (`@@index([cycle_slot])` serves it).
///
/// `bundle_gz` is the bundle's canonical text (sorted keys, no spaces, UTF-8)
/// compressed as `bundle_encoding` says. `inputs_sha256` is the SHA-256 of the TEXT,
/// not of the compressed bytes, so it survives a change of compression; every
/// `mcd_outputs` row of the cycle carries the same value. A bundle that cannot be
/// written as JSON has no canonical text and gets no row here.
model MarketCycleInput {
  id String @id @default(cuid())

  symbol     String
  cycle_slot Int // unix UTC, a multiple of 300

  bundle_gz       Bytes // the canonical bundle text, compressed
  bundle_encoding String // gzip
  bundle_bytes    Int // length of the canonical text in bytes, before compression: what a replay must get back
  inputs_sha256   String // SHA-256 (hex) of the canonical text

  // The bundle's own `retuning` field, copied out so the cycles of a promote can be
  // found without decompressing. Whether the sensors were told is a property of the
  // run: it sits on the mcd_outputs rows as `retuning_applied`.
  retuning_observed Boolean

  created_at DateTime @default(now())

  // No @updatedAt, deliberately: this table is never updated.
  @@unique([symbol, cycle_slot])
  @@index([cycle_slot])
  @@map("market_cycle_inputs")
}

/// Measured statistics per MCD state and horizon (architecture 2.8, A6): the only
/// source of a number, or of a confidence word, in any prompt. One row per series,
/// state and horizon, recomputed in place as the history grows, so unlike
/// `mcd_outputs` it has an `updated_at`.
///
/// A series is one evaluator MAJOR.MINOR (`evaluator_version_series`, for example
/// 2.0; a PATCH continues it) read over one set of source tunings
/// (`config_hash_key`, the canonical JSON text of the envelope's `config_hash`
/// object: sorted keys, no spaces). A new MINOR or a new tuning starts a new series
/// and never rewrites an old one.
///
/// THE n >= 30 RULE (ADR-022). Below 30 the row holds `n` and no number: every
/// measured column is NULL, enforced by the CHECK `state_statistics_n_gate` in
/// the migration. A reader answers "provisional" and uses words only. At 30 or more
/// a number is always read together with its `n`. Changing 30 is a new decision and
/// a new migration.
///
/// The measured columns say WHAT is measured. The arithmetic (the reference price
/// of a forward move, the horizon) is fixed in build step 3 part 6, and the share
/// that reached the next opposing level before a structural stop needs levels and
/// stops that build step 4 defines: it stays NULL until then.
///
/// `series_notes` states what is known to limit the series. Every series carries
/// the forming-bar limitation (waiting-on.md: the fit may include the still-open
/// bar) until certification settles it.
model StateStatistic {
  id String @id @default(cuid())

  mcd_id                   String
  evaluator_version_series String // MAJOR.MINOR
  config_hash_key          String // canonical JSON text of the series' config_hash object
  state_code               String
  horizon_hours            Int // 2 (Scalper) or 12 (Day Trader)

  n Int // occurrences of the state in the series' history that have an outcome at this horizon

  // All NULL unless n >= 30 (CHECK state_statistics_n_gate). Units are the
  // price's own; part 6 fixes the sign convention beside the arithmetic.
  forward_move_median      Float?
  forward_move_q1          Float?
  forward_move_q3          Float?
  opposing_level_rate      Float? // a fraction from 0 to 1, never a percentage
  adverse_excursion_median Float?
  adverse_excursion_q3     Float?

  series_notes String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([mcd_id, evaluator_version_series, config_hash_key, state_code, horizon_hours], map: "state_statistics_series_key")
  @@map("state_statistics")
}

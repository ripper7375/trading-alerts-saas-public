# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Same production Postgres as the root Next.js app (plan §1) — pooled
# (PgBouncer) connection string, matching lib/db/prisma.ts's convention.
DATABASE_URL=

# Redis for the ThrottlerGuard's storage (own instance — see railway.toml).
REDIS_URL=redis://localhost:6379

# Shared with the Next.js app (docs/secret-matrix.md) — never as a CLI arg,
# never printed. Granted via Railway's variable-set mechanism once this
# service exists (Session 3-1, Step 6).
NEXTAUTH_SECRET=

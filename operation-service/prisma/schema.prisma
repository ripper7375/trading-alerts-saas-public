// This schema exists ONLY so operation-service can `prisma generate` a typed
// client. It is NOT the source of truth for migrations — the root Next.js
// app's `prisma/non-market-data/schema.prisma` owns the actual tables and
// migration history (LESSONS-LEARNED.md L24: one shared migration history
// against one shared Postgres, even across split schema files).
// NEVER run `prisma migrate`/`db push` from this package.
//
// Session 3-2 (token endpoints, F23): hand-copied `User` and `RefreshToken`
// below, same "byte-for-byte hand-sync, no automated check" caveat
// railway-gateway/prisma/schema.prisma already carries for MarketDataV6 —
// any future change to either model in prisma/non-market-data/schema.prisma
// must be mirrored here by hand.
//
// `User` is intentionally a NARROW subset, not the full model: only the
// fields operation-service's auth endpoints (login/register/refresh/logout/
// me, plus Session 3-4's 2FA/forgot-password/reset-password/verify-email/
// resend-verification endpoints) actually read or write. No relations
// (Account[]/Alert[]/Drawing[]/etc.) are declared — this service has no
// business logic for any of them yet, and declaring them would require
// also modeling every related table. Deviation from the order's open
// question (Known schema gap section): narrow subset chosen over the full
// model, recorded in this order's Deviations section.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserTier {
  FREE
  PRO
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  password             String?
  image                String?
  emailVerified        DateTime?
  tier                 UserTier  @default(FREE)
  role                 String    @default("USER")
  isActive             Boolean   @default(true)
  isAffiliate          Boolean   @default(false)
  verificationToken    String?   @unique
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  twoFactorVerifiedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
}

/// Mirrors prisma/non-market-data/schema.prisma's RefreshToken exactly (F23).
model RefreshToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Session 4B-11 (User Profile/2FA/Sessions/Account Deletion): 4 more narrow-
// subset mirrors of prisma/non-market-data/schema.prisma models, plus
// NextAuth's own bare Session model — added at CONFIRM after an Executor
// audit found the APPROVED order's Entry Criterion 2 named 2 models that
// don't exist anywhere (Account, TwoFactorBackupCode — backup codes are
// just a JSON string field on User, see above) while omitting these 4 real
// ones. `userId` kept as a bare scalar on all 4 (no `User @relation`), same
// convention as every other narrow-subset model in this file — none of the
// 14 ported SOURCE routes or their lib/ dependencies traverse a relation
// (`include: { user: true }`), only flat `where: { userId }` lookups.
// Table names/`@@map` values copied exactly from the source-of-truth schema
// so these hit the identical shared Postgres tables (L1: this file never
// migrates, only hand-mirrors for `prisma generate`).

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  preferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  status    String   @default("PENDING")
  expiresAt DateTime

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([status])
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}

/// Tracks all login attempts for security monitoring.
model LoginHistory {
  id     String      @id @default(cuid())
  userId String
  status LoginStatus
  provider String

  userAgent      String?
  deviceType     String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?

  ipAddress String?
  country   String?
  city      String?
  region    String?

  deviceFingerprint String?
  isNewDevice       Boolean @default(false)

  failureReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([ipAddress])
  @@index([deviceFingerprint])
  @@index([createdAt])
  @@map("login_history")
}

/// Extended session tracking for device/location monitoring (distinct from
/// NextAuth's own bare Session model below) — the real model behind
/// "list/revoke sessions" in the ported SOURCE (lib/auth/session-tracker.ts).
model UserSession {
  id     String @id @default(cuid())
  userId String

  userAgent      String?
  ipAddress      String?
  deviceType     String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?

  country String?
  city    String?
  region  String?

  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  sessionToken String? @unique

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([lastActiveAt])
  @@map("user_sessions")
}

/// NextAuth's own session table — mirrored ONLY because
/// session-tracker.ts's revoke functions delete rows here by
/// `sessionToken` when revoking a UserSession. No relation to User (never
/// traversed by the ported code).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

// Session 3-4: NARROW subset mirror of prisma/non-market-data/schema.prisma's
// SecurityAlert, same convention as User above — only the fields the 2FA
// enable/disable endpoints actually write (a create-only write path this
// session; nothing here ever reads SecurityAlert rows back). `deviceInfo`/
// `read`/`readAt` are the source model's own fields for its OTHER caller
// (new-device-login alerts, out of this session's scope) and are
// deliberately omitted — the real DB columns still get their own defaults
// on insert regardless of what this generate-only schema declares.
// @@map is load-bearing: the real table is `security_alerts`, not the
// PascalCase default Prisma would otherwise assume.
enum SecurityAlertType {
  NEW_DEVICE_LOGIN
  PASSWORD_CHANGED
  EMAIL_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SUSPICIOUS_LOGIN
  ACCOUNT_LOCKED
}

model SecurityAlert {
  id          String            @id @default(cuid())
  userId      String
  type        SecurityAlertType
  title       String
  message     String
  ipAddress   String?
  location    String?
  emailSent   Boolean           @default(false)
  emailSentAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@map("security_alerts")
}

// Session 4B-2 (Alert Engine BUILD, F9 downstream): mirrors
// prisma/non-market-data/schema.prisma's Alert/Notification/DrawingAlert/
// Drawing models. `userId` on Alert/Drawing is kept as a bare scalar, not a
// `User @relation` — same convention 4A-W2 established for FKs no ported
// code actually traverses (nothing in lib/alert-engine/* or lib/jobs/*
// reads .user off Alert or Drawing, only the userId scalar). DrawingAlert's
// relations to Drawing/Alert ARE real Prisma relations (not bare scalars):
// `lib/alert-engine/worker.ts`'s `prisma.drawingAlert.findMany({ where: {
// alert: { isActive: true } }, include: { drawing: true, alert: true } })`
// genuinely traverses both via Prisma's relational query features, so both
// sides need their opposite relation field for `prisma generate` to
// validate. Deviation from Step 0's own file list, which named only
// Alert/Notification/MarketDataV6 — found while porting File 12 (worker.ts)
// and its DrawingAlertRow dependency; not in the order's own SOURCE list.

enum NotificationType {
  ALERT
  SUBSCRIPTION
  PAYMENT
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

model Notification {
  id       String               @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  body     String
  priority NotificationPriority @default(MEDIUM)

  read   Boolean   @default(false)
  readAt DateTime?

  link String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Alert {
  id     String @id @default(cuid())
  userId String

  name      String?
  symbol    String
  timeframe String
  condition String
  alertType String @default("PRICE_TOUCH_LINE")

  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  triggerCount  Int       @default(0)

  drawingAlert DrawingAlert?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([symbol, timeframe])
  @@index([isActive])
}

model Drawing {
  id     String @id @default(cuid())
  userId String

  symbol    String
  timeframe String
  type      String
  anchors   Json
  style     Json

  alerts DrawingAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([symbol, timeframe])
  @@index([userId, symbol, timeframe])
}

model DrawingAlert {
  id        String   @id @default(cuid())
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  alertId   String   @unique
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  targetLevel String
  direction   String  @default("either")
  tolerance   Float   @default(0)
  cooldownSec Int     @default(60)
  oneShot     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drawingId])
}

// Session 4B-2: NARROW subset mirror of prisma/market-data/schema.prisma's
// MarketDataV6 (79 fields total) — same convention as User/SecurityAlert
// above. Only the fields `lib/jobs/alert-checker.ts`'s
// fetchXauusdPriceFromGatewayPipeline actually reads
// (`findFirst({ where: { symbol, timeframe }, orderBy: { timestamp: 'desc'
// } })`, then `.close`) are declared. Same physical Postgres instance as
// every other model in this file — confirmed via lib/db/prisma.ts and
// lib/db/market-prisma.ts both reading DATABASE_URL; the monolith's
// market/non-market split is two schema FILES (two generated clients) over
// one database, not two databases, so this can live in the same
// operation-service client rather than needing a second one.
model MarketDataV6 {
  id        String @id @default(cuid())
  symbol    String
  timeframe String
  timestamp Int
  close     Float

  // Session 4B-12: 18 centroid-regression channel columns, additive-only —
  // already exist in the live market_data_v6 table (mirrors
  // prisma/market-data/schema.prisma exactly, field-for-field), needed by
  // the market-data channel proxy's dynamic `${variant}_{uoedt,base_fl,
  // loedt}` reads. No migration required (prisma generate only, per L1).
  best_fit_base_fl    Float?
  best_fit_uoedt      Float?
  best_fit_loedt      Float?
  cherry_a_base_fl    Float?
  cherry_a_uoedt      Float?
  cherry_a_loedt      Float?
  cherry_b_base_fl    Float?
  cherry_b_uoedt      Float?
  cherry_b_loedt      Float?
  most_recent_base_fl Float?
  most_recent_uoedt   Float?
  most_recent_loedt   Float?
  non_a_base_fl       Float?
  non_a_uoedt         Float?
  non_a_loedt         Float?
  non_b_base_fl       Float?
  non_b_uoedt         Float?
  non_b_loedt         Float?

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("market_data_v6")
}

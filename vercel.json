{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [[ \"$VERCEL_GIT_COMMIT_REF\" == claude/* ]] || [[ \"$VERCEL_GIT_COMMIT_REF\" == docs/* ]]; then exit 0; else exit 1; fi",
  "crons": [
    {
      "path": "/api/cron/distribute-codes",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/send-monthly-reports",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/expire-codes",
      "schedule": "59 23 28-31 * *"
    },
    {
      "path": "/api/cron/check-expiring-subscriptions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/downgrade-expired-subscriptions",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/process-pending-disbursements",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-riseworks-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-maintenance",
      "schedule": "0 4 * * *"
    }
  ]
}

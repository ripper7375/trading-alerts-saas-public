# ==============================================================================
# Trading Alerts SaaS - Environment Variables Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` in your Next.js project root
# 2. Fill in all required values
# 3. NEVER commit .env.local to git (already in .gitignore)
# 4. Keep these secrets secure!
#
# ==============================================================================

# ------------------------------------------------------------------------------
# AUTHENTICATION (Required in Production)
# ------------------------------------------------------------------------------
# NextAuth.js configuration for user authentication

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Twitter/X - https://developer.twitter.com/en/portal/projects
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# LinkedIn - https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Environment-specific URL
NEXTAUTH_URL=http://localhost:3000

# Production (update when deploying)
# NEXTAUTH_URL=https://your-domain.vercel.app

# ------------------------------------------------------------------------------
# DATABASE (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string

# Local development example:
# DATABASE_URL=postgresql://username:password@localhost:5432/trading_alerts

# Railway production (get from Railway dashboard):
DATABASE_URL=postgresql://postgres:your_password@your_region.railway.app:5432/railway


# ------------------------------------------------------------------------------
# PART 20 DATA INFRASTRUCTURE (Required)
# ------------------------------------------------------------------------------
# PostgreSQL (TimescaleDB) and Redis for indicator data
# Replaces Part 6 Flask MT5 Service

# PostgreSQL connection (Railway production)
# Get from Railway dashboard: postgresql://user:password@host:5432/database
POSTGRESQL_URI=postgresql://postgres:your_password@your_region.railway.app:5432/railway

# Redis connection (Railway production)
# Get from Railway dashboard
REDIS_URL=redis://default:your_password@your_region.railway.app:6379

# Sync configuration (Contabo VPS only - where MQL5 services run)
# SQLITE_PATH=C:\MT5Data\trading_data.db
# SYNC_INTERVAL=30

# Admin API key for maintenance endpoints
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here

# ------------------------------------------------------------------------------
# STRIPE (Required for PRO Tier Payments)
# ------------------------------------------------------------------------------
# Payment processing for PRO tier subscriptions ($29/month)

# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Get from: https://dashboard.stripe.com/webhooks (after creating webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Public key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Pro Price ID (create in Stripe Dashboard)
STRIPE_PRO_PRICE_ID=price_your_pro_price_id


# ------------------------------------------------------------------------------
# EMAIL (Recommended for Production)
# ------------------------------------------------------------------------------
# Transactional emails via Resend.com (verification, password reset, alerts)

# Get from: https://resend.com/api-keys
# Free tier: 100 emails/day
RESEND_API_KEY=re_your_resend_api_key


# ------------------------------------------------------------------------------
# MINIMAX M2 (Required for AI Development)
# ------------------------------------------------------------------------------
# Cost-effective AI development with Aider

# Get from: https://platform.minimax.io
OPENAI_API_KEY=your_minimax_api_key_here

# MiniMax API endpoint (do not change)
OPENAI_API_BASE=https://api.minimax.io/v1


# ------------------------------------------------------------------------------
# GITHUB (Optional - for Aider GitHub integration)
# ------------------------------------------------------------------------------
# Personal access token for Aider to push commits

# Get from: https://github.com/settings/tokens
# Scopes needed: repo, workflow, write:packages
# GITHUB_TOKEN=ghp_your_github_token


# ------------------------------------------------------------------------------
# ADMIN USER (Optional - for initial setup)
# ------------------------------------------------------------------------------
# Default admin credentials for Prisma seed script
# CHANGE IMMEDIATELY after first login!

# ADMIN_EMAIL=admin@davintrade.com
# ADMIN_PASSWORD=ChangeMe123!


# ==============================================================================
# PHASE-SPECIFIC NOTES
# ==============================================================================

# PHASE 0-1 (Setup & Policies):
# - Only OPENAI_API_KEY and OPENAI_API_BASE required

# PHASE 2 (Foundation):
# - Add DATABASE_URL for Railway PostgreSQL
# - Add NEXTAUTH_SECRET (generate locally)

# PHASE 3-4 (Part 20 Data Infrastructure):
# - Add POSTGRESQL_URI for Railway PostgreSQL (TimescaleDB)
# - Add REDIS_URL for Railway Redis
# - Add ADMIN_API_KEY for maintenance endpoints
# - On Contabo VPS: Configure SQLITE_PATH and SYNC_INTERVAL

# PHASE 5 (Deployment):
# - Update NEXTAUTH_URL to production Vercel URL
# - Add STRIPE keys (if implementing payments)
# - Add RESEND_API_KEY (if implementing emails)

# PHASE 6 (Maintenance):
# - All variables should be set
# - Monitor and update as needed



# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
#
# ✅ DO:
# - Generate strong random values for secrets
# - Use different keys for development vs production
# - Store production secrets in secure vault (Vercel, Railway)
# - Rotate keys periodically
# - Use HTTPS in production
#
# ❌ DON'T:
# - Commit .env.local to git
# - Share secrets in chat/email
# - Use same password across services
# - Hardcode secrets in code
# - Use weak/predictable passwords
#
# ==============================================================================

# ==============================================================================
# HELPFUL COMMANDS
# ==============================================================================
#
# Generate random secrets:
#   openssl rand -base64 32  # For NEXTAUTH_SECRET
#   openssl rand -hex 32     # For MT5_API_KEY
#
# Test database connection:
#   npx prisma db push
#   npx prisma studio
#
# Run development server:
#   pnpm dev
#
# Run Flask service:
#   cd mt5-service
#   python run.py
#
# ==============================================================================